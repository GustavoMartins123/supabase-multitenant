+// Local Studio management uses the authenticated gateway, never project API keys.
+import { useQuery } from '@tanstack/react-query'
+import { useParams } from 'common'
+import Link from 'next/link'
+import { useRouter } from 'next/router'
+import { useEffect, useRef, useState, type ChangeEvent, type ReactNode } from 'react'
+import { toast } from 'sonner'
+import { Button, Input, Label } from 'ui'
+
+import DefaultLayout from '@/components/layouts/DefaultLayout'
+import EdgeFunctionsLayout from '@/components/layouts/EdgeFunctionsLayout/EdgeFunctionsLayout'
+import { DiscardChangesConfirmationDialog } from '@/components/ui-patterns/Dialogs/DiscardChangesConfirmationDialog'
+import { FileExplorerAndEditor } from '@/components/ui/FileExplorerAndEditor'
+import type { FileData } from '@/components/ui/FileExplorerAndEditor/FileExplorerAndEditor.types'
+import { usePreventNavigationOnUnsavedChanges } from '@/hooks/ui/usePreventNavigationOnUnsavedChanges'
+import { BASE_PATH } from '@/lib/constants'
+import type { NextPageWithLayout } from '@/types'
+
+type FunctionInfo = {
+  name: string
+  revision: string | null
+  published_revision: string | null
+}
+type FunctionList = { enabled: boolean; functions: FunctionInfo[] }
+type FunctionBody = FunctionInfo & { enabled: boolean; files: { name: string; content: string }[] }
+
+async function management<T>(ref: string, suffix = '', options: RequestInit = {}): Promise<T> {
+  const response = await fetch(
+    `${BASE_PATH}/api/platform/projects/${encodeURIComponent(ref)}/edge-functions${suffix}`,
+    {
+      ...options,
+      credentials: 'same-origin',
+      redirect: 'manual',
+      cache: 'no-store',
+      headers: { 'Content-Type': 'application/json', 'X-Studio-Project-Ref': ref },
+    }
+  )
+  if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) {
+    throw new Error('Your Studio session must be renewed.')
+  }
+  const data = await response.json()
+  if (!response.ok) {
+    throw new Error(typeof data.detail === 'string' ? data.detail : data.message || 'Function request denied')
+  }
+  return data as T
+}
+
+function BlockedNotice({ enabled }: { enabled: boolean }) {
+  if (enabled) return null
+  return (
+    <p role="status" className="rounded border border-warning p-3 text-sm">
+      Edge Functions are disabled for this project. Drafts can be saved; publication and public
+      invocation remain blocked until a project administrator enables the service in project settings.
+    </p>
+  )
+}
+
+function FunctionsList({ projectRef }: { projectRef: string }) {
+  const query = useQuery({
+    queryKey: ['local-edge-functions', projectRef],
+    queryFn: ({ signal }) => management<FunctionList>(projectRef, '', { signal }),
+    retry: false,
+    gcTime: 0,
+  })
+  return (
+    <div className="p-6 space-y-5 w-full max-w-6xl mx-auto">
+      <div className="flex items-center justify-between">
+        <h1 className="text-xl">Edge Functions</h1>
+        {query.data && (
+          <Button asChild><Link href={`/project/${projectRef}/functions/new`}>Create function</Link></Button>
+        )}
+      </div>
+      {query.isPending && <p role="status">Loading functions…</p>}
+      {query.error && <p role="alert">{query.error.message}</p>}
+      {query.data && <>
+        <BlockedNotice enabled={query.data.enabled} />
+        <p className="text-sm text-foreground-light">Project: {projectRef}</p>
+        {query.data.functions.length === 0 && <p>No functions yet.</p>}
+        <ul className="divide-y border rounded">
+          {query.data.functions.map((item) => (
+            <li key={item.name} className="flex justify-between p-4">
+              <Link className="text-brand" href={`/project/${projectRef}/functions/${item.name}/code`}>
+                {item.name}
+              </Link>
+              <span className="text-sm text-foreground-light">
+                {!item.published_revision ? 'Draft' : item.revision !== item.published_revision ? 'Unpublished changes' : 'Published'}
+              </span>
+            </li>
+          ))}
+        </ul>
+      </>}
+    </div>
+  )
+}
+
+const STARTER = 'Deno.serve((_request) => Response.json({ message: "Hello from your project" }))\n'
+const asFiles = (data: FunctionBody): FileData[] =>
+  data.files.map((file, id) => ({ ...file, id, state: 'unchanged' }))
+const fingerprint = (files: FileData[]) => JSON.stringify(files.map(({ name, content }) => ({ name, content })))
+
+function FunctionEditor({ projectRef, slug }: { projectRef: string; slug?: string }) {
+  const [name, setName] = useState(slug ?? '')
+  const [info, setInfo] = useState<FunctionBody>()
+  const [files, setFiles] = useState<FileData[]>([{ id: 0, name: 'index.ts', content: STARTER, state: 'new' }])
+  const [saved, setSaved] = useState(slug ? '' : fingerprint(files))
+  const [busy, setBusy] = useState(false)
+  const [failure, setFailure] = useState('')
+  const [selected, setSelected] = useState(0)
+  const mounted = useRef(true)
+  useEffect(() => { mounted.current = true; return () => { mounted.current = false } }, [])
+  const query = useQuery<FunctionList | FunctionBody>({
+    queryKey: ['local-edge-function', projectRef, slug],
+    queryFn: ({ signal }) => slug
+      ? management<FunctionBody>(projectRef, `/${encodeURIComponent(slug)}`, { signal })
+      : management<FunctionList>(projectRef, '', { signal }),
+    retry: false,
+    gcTime: 0,
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false,
+  })
+  useEffect(() => {
+    if (slug && query.data && 'files' in query.data && !info) {
+      setInfo(query.data)
+      const loaded = asFiles(query.data)
+      setFiles(loaded)
+      setSaved(fingerprint(loaded))
+    }
+  }, [slug, query.data, info])
+  const dirty = fingerprint(files) !== saved
+  const navigation = usePreventNavigationOnUnsavedChanges({ hasChanges: dirty || busy })
+  const enabled = info?.enabled ?? query.data?.enabled ?? false
+  const loaded = !!query.data && (!slug || !!info)
+  const validName = /^[A-Za-z][A-Za-z0-9_-]{0,63}$/.test(name) && name !== 'main'
+
+  async function save() {
+    setBusy(true)
+    setFailure('')
+    try {
+      const result = await management<FunctionBody>(projectRef, `/${encodeURIComponent(name)}`, {
+        method: 'PUT',
+        body: JSON.stringify({
+          expected_revision: info?.revision ?? null,
+          files: files.map(({ name, content }) => ({ name, content })),
+        }),
+      })
+      if (!mounted.current) return
+      setInfo(result)
+      setSaved(fingerprint(files))
+      toast.success('Draft saved. Public code has not changed.')
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Draft save failed')
+    } finally { if (mounted.current) setBusy(false) }
+  }
+
+  async function publish() {
+    if (!info?.revision || dirty) return
+    setBusy(true)
+    setFailure('')
+    try {
+      const result = await management<FunctionBody>(projectRef, `/${encodeURIComponent(name)}/publish`, {
+        method: 'POST',
+        body: JSON.stringify({ revision: info.revision, expected_published_revision: info.published_revision }),
+      })
+      if (!mounted.current) return
+      setInfo(result)
+      toast.success('Function published for this project.')
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Publication failed')
+    } finally { if (mounted.current) setBusy(false) }
+  }
+
+  return (
+    <div className="w-full flex flex-col min-h-[70vh]">
+      <div className="p-5 space-y-3 border-b">
+        <Link className="text-brand text-sm" href={`/project/${projectRef}/functions`}>Back to functions</Link>
+        <h1 className="text-xl">{slug || info ? name : 'Create function'}</h1>
+        <p className="text-sm text-foreground-light">Project: {projectRef}</p>
+        {loaded && <BlockedNotice enabled={enabled} />}
+        {query.error && <p role="alert">{query.error.message}</p>}
+        {failure && <p role="alert">{failure}</p>}
+        {info?.published_revision && <p className="text-sm">
+          {info.revision === info.published_revision ? 'Published version' : 'Unpublished draft'}
+          {' · '}Public path: /{projectRef}/functions/v1/{name}
+        </p>}
+      </div>
+      {!loaded && !query.error && <p role="status" className="p-5">Loading editor…</p>}
+      {loaded && <>
+        <div inert={busy} className="flex flex-col flex-1 min-h-[450px]">
+          <FileExplorerAndEditor editable files={files} onFilesChange={setFiles} selectedFileId={selected} setSelectedFileId={setSelected} />
+        </div>
+        <div className="flex items-center justify-end gap-4 p-4 border-t">
+          <Label htmlFor="local-function-name">Function name</Label>
+          <Input id="local-function-name" className="w-64" value={name} disabled={!!slug || !!info || busy}
+            onChange={(event: ChangeEvent<HTMLInputElement>) => setName(event.target.value)} placeholder="my-function" />
+          <Button variant="default" loading={busy} disabled={busy || !validName || !files.length} onClick={save}>Save draft</Button>
+          <Button disabled={busy || !enabled || !info?.revision || dirty || info.revision === info.published_revision} onClick={publish}>Publish function</Button>
+        </div>
+      </>}
+      <DiscardChangesConfirmationDialog visible={navigation.shouldConfirmNavigation}
+        onCancel={navigation.handleCancelNavigation} onClose={navigation.handleConfirmNavigation} />
+    </div>
+  )
+}
+
+export const SelfHostedEdgeFunctionsPage: NextPageWithLayout = () => {
+  const { ref, functionSlug } = useParams()
+  const router = useRouter()
+  if (!ref) return <p role="alert">A project context is required.</p>
+  const isEditor = router.pathname !== '/project/[ref]/functions'
+  return isEditor
+    ? <FunctionEditor key={`${ref}:${functionSlug ?? 'new'}`} projectRef={ref} slug={functionSlug} />
+    : <FunctionsList key={ref} projectRef={ref} />
+}
+SelfHostedEdgeFunctionsPage.getLayout = (page: ReactNode) => (
+  <DefaultLayout><EdgeFunctionsLayout title="Edge Functions">{page}</EdgeFunctionsLayout></DefaultLayout>
+)
