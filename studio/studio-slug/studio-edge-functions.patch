+
+function encodeBase64Bytes(bytes: Uint8Array): string {
+  let binary = ''
+  const chunkSize = 0x8000
+  for (let i = 0; i < bytes.length; i += chunkSize) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize))
+  }
+  return btoa(binary)
+}
+
+function decodedBase64Length(b64: string): number {
+  const clean = b64.replace(/\s+/g, '')
+  if (!clean) return 0
+  const padding = clean.endsWith('==') ? 2 : clean.endsWith('=') ? 1 : 0
+  return Math.max(0, Math.floor((clean.length * 3) / 4) - padding)
+}
+
+function hasValidWasmMagic(bytes: Uint8Array): boolean {
+  return (
+    bytes.length >= 8 &&
+    bytes[0] === 0x00 &&
+    bytes[1] === 0x61 &&
+    bytes[2] === 0x73 &&
+    bytes[3] === 0x6d &&
+    bytes[4] === 0x01 &&
+    bytes[5] === 0x00 &&
+    bytes[6] === 0x00 &&
+    bytes[7] === 0x00
+  )
+}
+
+async function management<T>(ref: string, suffix = '', options: RequestInit = {}): Promise<T> {
+  const response = await fetch(
+    `${BASE_PATH}/api/platform/projects/${encodeURIComponent(ref)}/edge-functions${suffix}`,
+    {
+      ...options,
+      credentials: 'same-origin',
+      redirect: 'manual',
+      cache: 'no-store',
+      headers: {
+        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
+        'X-Studio-Project-Ref': ref,
+        ...(options.headers ?? {}),
+      },
+    }
+  )
+  if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) {
+    throw new Error('Your Studio session must be renewed.')
+  }
+  const data = await response.json()
+  if (!response.ok) {
+    throw new Error(typeof data.detail === 'string' ? data.detail : data.message || 'Function request denied')
+  }
+  return data as T
+}
+
+async function downloadBundle(ref: string, slug: string, versionSelector: string): Promise<void> {
+  const response = await fetch(
+    `${BASE_PATH}/api/platform/projects/${encodeURIComponent(ref)}/edge-functions/${encodeURIComponent(slug)}/download?version=${encodeURIComponent(versionSelector)}`,
+    {
+      method: 'GET',
+      credentials: 'same-origin',
+      redirect: 'manual',
+      cache: 'no-store',
+      headers: { 'X-Studio-Project-Ref': ref },
+    }
+  )
+  if (response.redirected) {
+    throw new Error('Your Studio session must be renewed.')
+  }
+  if (!response.ok) {
+    let message = 'Bundle download failed'
+    try {
+      const data = await response.json()
+      if (typeof data?.detail === 'string') message = data.detail
+    } catch {}
+    throw new Error(message)
+  }
+  const blob = await response.blob()
+  const objectUrl = URL.createObjectURL(blob)
+  try {
+    const link = document.createElement('a')
+    link.href = objectUrl
+    link.download = `${slug}-${versionSelector.slice(0, 12)}.zip`
+    document.body.appendChild(link)
+    link.click()
+    link.remove()
+  } finally {
+    URL.revokeObjectURL(objectUrl)
+  }
+}
