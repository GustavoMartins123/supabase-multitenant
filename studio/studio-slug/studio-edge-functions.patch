+function SchedulesPanel({
+  projectRef,
+  slug,
+  enabled,
+  publishedFunctions = [],
+}: {
+  projectRef: string
+  slug?: string
+  enabled: boolean
+  publishedFunctions?: string[]
+}) {
+  const queryClient = useQueryClient()
+  const [targetSlug, setTargetSlug] = useState(slug ?? publishedFunctions[0] ?? '')
+  const [schedName, setSchedName] = useState('')
+  const [cronExpr, setCronExpr] = useState('*/15 * * * *')
+  const [method, setMethod] = useState<'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE'>('POST')
+  const [path, setPath] = useState('/')
+  const [authMode, setAuthMode] = useState<'service_role' | 'anon' | 'none'>('service_role')
+  const [body, setBody] = useState('')
+  const [schedEnabled, setSchedEnabled] = useState(true)
+  const [creating, setCreating] = useState(false)
+  const [busyId, setBusyId] = useState<string | null>(null)
+  const [formError, setFormError] = useState('')
+
+  useEffect(() => {
+    if (slug) {
+      setTargetSlug(slug)
+    } else if (!targetSlug && publishedFunctions.length > 0) {
+      setTargetSlug(publishedFunctions[0])
+    }
+  }, [slug, targetSlug, publishedFunctions])
+
+  const endpoint = slug ? `/${encodeURIComponent(slug)}/schedules` : '/schedules'
+  const query = useQuery({
+    queryKey: ['local-edge-schedules', projectRef, slug ?? 'all'],
+    queryFn: ({ signal }) => management<{ schedules: FunctionSchedule[] }>(projectRef, endpoint, { signal }),
+    retry: false,
+    gcTime: 0,
+  })
+
+  async function refresh() {
+    await queryClient.invalidateQueries({ queryKey: ['local-edge-schedules', projectRef] })
+  }
+
+  async function createSchedule() {
+    const fnSlug = slug ?? targetSlug
+    if (!fnSlug || !schedName.trim() || !cronExpr.trim()) return
+    setCreating(true)
+    setFormError('')
+    try {
+      await management<{ schedule: FunctionSchedule }>(
+        projectRef,
+        `/${encodeURIComponent(fnSlug)}/schedules`,
+        {
+          method: 'POST',
+          body: JSON.stringify({
+            name: schedName.trim(),
+            cron: cronExpr.trim(),
+            timezone: 'UTC',
+            method,
+            path: path.trim() || '/',
+            headers: {},
+            body: method === 'GET' ? '' : body,
+            auth_mode: authMode,
+            enabled: schedEnabled,
+          }),
+        }
+      )
+      setSchedName('')
+      setBody('')
+      toast.success('Schedule created.')
+      await refresh()
+    } catch (error) {
+      setFormError(error instanceof Error ? error.message : 'Failed to create schedule')
+    } finally {
+      setCreating(false)
+    }
+  }
+
+  async function toggleSchedule(sched: FunctionSchedule) {
+    setBusyId(sched.id)
+    setFormError('')
+    try {
+      await management<{ schedule: FunctionSchedule }>(
+        projectRef,
+        `/${encodeURIComponent(sched.function_name)}/schedules/${encodeURIComponent(sched.id)}`,
+        { method: 'PUT', body: JSON.stringify({ enabled: !sched.enabled }) }
+      )
+      toast.success(sched.enabled ? 'Schedule paused.' : 'Schedule resumed.')
+      await refresh()
+    } catch (error) {
+      setFormError(error instanceof Error ? error.message : 'Failed to update schedule')
+    } finally {
+      setBusyId(null)
+    }
+  }
+
+  async function triggerNow(sched: FunctionSchedule) {
+    setBusyId(sched.id)
+    setFormError('')
+    try {
+      const res = await management<{ schedule: FunctionSchedule; invocation: { status: number; duration_ms: number } }>(
+        projectRef,
+        `/${encodeURIComponent(sched.function_name)}/schedules/${encodeURIComponent(sched.id)}/trigger`,
+        { method: 'POST', body: JSON.stringify({}) }
+      )
+      toast.success(`Triggered "${sched.name}": HTTP ${res.invocation.status} (${res.invocation.duration_ms}ms)`)
+      await refresh()
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-logs', projectRef] })
+    } catch (error) {
+      setFormError(error instanceof Error ? error.message : 'Failed to trigger schedule')
+    } finally {
+      setBusyId(null)
+    }
+  }
+
+  async function deleteSchedule(sched: FunctionSchedule) {
+    setBusyId(sched.id)
+    setFormError('')
+    try {
+      await management(
+        projectRef,
+        `/${encodeURIComponent(sched.function_name)}/schedules/${encodeURIComponent(sched.id)}`,
+        { method: 'DELETE' }
+      )
+      toast.success(`Schedule "${sched.name}" deleted.`)
+      await refresh()
+    } catch (error) {
+      setFormError(error instanceof Error ? error.message : 'Failed to delete schedule')
+    } finally {
+      setBusyId(null)
+    }
+  }
+
+  const canSelectFunction = !slug && publishedFunctions.length > 0
+  const effectiveFn = slug ?? targetSlug
+
+  return (
+    <div className="space-y-4">
+      <div className="rounded border p-4 space-y-3 text-sm">
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <div>
+            <h2 className="font-medium">Cron Schedules (UTC)</h2>
+            <p className="text-xs text-foreground-light">
+              Schedules execute published functions automatically via the advisory-locked scheduler and are automatically disabled or removed when a function is unpublished, deleted, or disabled.
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-1.5">
+            {(['*/5 * * * *', '*/15 * * * *', '@hourly', '@daily'] as const).map((preset) => (
+              <Button key={preset} size="tiny" variant="default" onClick={() => setCronExpr(preset)}>
+                {preset}
+              </Button>
+            ))}
+          </div>
+        </div>
+
+        {(slug || canSelectFunction) ? (
+          <div className="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
+            {canSelectFunction && (
+              <div>
+                <Label htmlFor="sched-fn">Function</Label>
+                <select
+                  id="sched-fn"
+                  className="block w-full rounded border bg-background px-2 py-2 text-sm"
+                  value={targetSlug}
+                  onChange={(event: ChangeEvent<HTMLSelectElement>) => setTargetSlug(event.target.value)}
+                >
+                  {publishedFunctions.map((fn) => (
+                    <option key={fn} value={fn}>{fn}</option>
+                  ))}
+                </select>
+              </div>
+            )}
+            <div>
+              <Label htmlFor="sched-name">Schedule Name</Label>
+              <Input
+                id="sched-name"
+                placeholder="nightly-cleanup"
+                value={schedName}
+                disabled={creating}
+                onChange={(event: ChangeEvent<HTMLInputElement>) => setSchedName(event.target.value)}
+              />
+            </div>
+            <div>
+              <Label htmlFor="sched-cron">Cron Expression (UTC)</Label>
+              <Input
+                id="sched-cron"
+                placeholder="*/15 * * * *"
+                value={cronExpr}
+                disabled={creating}
+                onChange={(event: ChangeEvent<HTMLInputElement>) => setCronExpr(event.target.value)}
+              />
+            </div>
+            <div>
+              <Label htmlFor="sched-method">Method</Label>
+              <select
+                id="sched-method"
+                className="block w-full rounded border bg-background px-2 py-2 text-sm"
+                value={method}
+                onChange={(event: ChangeEvent<HTMLSelectElement>) =>
+                  setMethod(event.target.value as 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE')
+                }
+              >
+                {['POST', 'GET', 'PUT', 'PATCH', 'DELETE'].map((m) => (
+                  <option key={m} value={m}>{m}</option>
+                ))}
+              </select>
+            </div>
+            <div>
+              <Label htmlFor="sched-path">Path</Label>
+              <Input
+                id="sched-path"
+                placeholder="/"
+                value={path}
+                disabled={creating}
+                onChange={(event: ChangeEvent<HTMLInputElement>) => setPath(event.target.value)}
+              />
+            </div>
+            <div>
+              <Label htmlFor="sched-auth">Auth Mode</Label>
+              <select
+                id="sched-auth"
+                className="block w-full rounded border bg-background px-2 py-2 text-sm"
+                value={authMode}
+                onChange={(event: ChangeEvent<HTMLSelectElement>) =>
+                  setAuthMode(event.target.value as 'anon' | 'service_role' | 'none')
+                }
+              >
+                <option value="service_role">Service Role</option>
+                <option value="anon">Anon Role</option>
+                <option value="none">Unauthenticated</option>
+              </select>
+            </div>
+            <div>
+              <Label htmlFor="sched-body">Payload (optional JSON)</Label>
+              <Input
+                id="sched-body"
+                placeholder='{"source":"cron"}'
+                value={body}
+                disabled={creating || method === 'GET'}
+                onChange={(event: ChangeEvent<HTMLInputElement>) => setBody(event.target.value)}
+              />
+            </div>
+            <div className="flex items-center justify-between gap-2">
+              <label className="flex items-center gap-1.5 text-xs">
+                <input
+                  type="checkbox"
+                  checked={schedEnabled}
+                  onChange={(event: ChangeEvent<HTMLInputElement>) => setSchedEnabled(event.target.checked)}
+                />
+                Enabled
+              </label>
+              <Button
+                loading={creating}
+                disabled={creating || !effectiveFn || !schedName.trim() || !cronExpr.trim()}
+                onClick={() => void createSchedule()}
+              >
+                Create Schedule
+              </Button>
+            </div>
+          </div>
+        ) : (
+          <p className="text-xs text-foreground-light">
+            Publish at least one function to create a project cron schedule.
+          </p>
+        )}
+        {formError && <p role="alert" className="text-xs text-destructive">{formError}</p>}
+      </div>
+
+      {query.isPending && <p role="status">Loading schedules…</p>}
+      {query.error && <p role="alert">{query.error.message}</p>}
+      {query.data && (
+        <div className="rounded border divide-y text-sm">
+          {query.data.schedules.length === 0 ? (
+            <p className="p-4 text-foreground-light">No cron schedules configured yet.</p>
+          ) : (
+            query.data.schedules.map((sched) => (
+              <div key={sched.id} className="p-3 flex flex-wrap items-center justify-between gap-3">
+                <div className="space-y-1">
+                  <div className="flex flex-wrap items-center gap-2">
+                    <span className="font-medium">{sched.name}</span>
+                    {!slug && <span className="font-mono text-xs text-brand">{sched.function_name}</span>}
+                    <span className="rounded border px-2 py-0.5 font-mono text-xs">{sched.cron}</span>
+                    <span className="rounded border px-2 py-0.5 text-xs">
+                      {sched.enabled ? 'Active' : 'Paused'}
+                    </span>
+                    <span className="text-xs text-foreground-light">
+                      {sched.method} {sched.path} ({sched.auth_mode})
+                    </span>
+                  </div>
+                  <div className="text-xs text-foreground-light">
+                    Next run: {sched.next_run_at ? new Date(sched.next_run_at).toLocaleString() : 'Not scheduled'}
+                    {' · '}
+                    Last run: {sched.last_run_at ? `${new Date(sched.last_run_at).toLocaleString()} (HTTP ${sched.last_status ?? '-'}, ${sched.last_duration_ms ?? 0}ms)` : 'Never'}
+                  </div>
+                  {sched.last_error && <div className="text-xs text-destructive">{sched.last_error}</div>}
+                </div>
+                <div className="flex flex-wrap gap-2">
+                  <Button
+                    size="tiny"
+                    variant="default"
+                    disabled={!enabled || busyId === sched.id}
+                    loading={busyId === sched.id}
+                    onClick={() => void triggerNow(sched)}
+                  >
+                    Trigger now
+                  </Button>
+                  <Button
+                    size="tiny"
+                    variant="default"
+                    disabled={busyId === sched.id}
+                    onClick={() => void toggleSchedule(sched)}
+                  >
+                    {sched.enabled ? 'Pause' : 'Resume'}
+                  </Button>
+                  <Button
+                    size="tiny"
+                    variant="danger"
+                    disabled={busyId === sched.id}
+                    onClick={() => void deleteSchedule(sched)}
+                  >
+                    Delete
+                  </Button>
+                </div>
+              </div>
+            ))
+          )}
+        </div>
+      )}
+    </div>
+  )
