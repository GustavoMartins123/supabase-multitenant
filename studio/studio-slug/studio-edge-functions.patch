+function LogsPanel({ projectRef, slug }: { projectRef: string; slug?: string }) {
+  const [level, setLevel] = useState('')
+  const [fnFilter, setFnFilter] = useState(slug ?? '')
+  const [limit, setLimit] = useState('50')
+
+  const params = new URLSearchParams()
+  if (level) params.set('level', level)
+  if (!slug && fnFilter.trim()) params.set('function', fnFilter.trim())
+  if (limit) params.set('limit', limit)
+  const path = slug
+    ? `/${encodeURIComponent(slug)}/logs?${params.toString()}`
+    : `/logs?${params.toString()}`
+
+  const query = useQuery({
+    queryKey: ['local-edge-logs', projectRef, slug ?? '', level, fnFilter, limit],
+    queryFn: ({ signal }) => management<LogsResponse>(projectRef, path, { signal }),
+    retry: false,
+    gcTime: 0,
+  })
+
+  return (
+    <div className="space-y-4">
+      <div className="flex flex-wrap items-end gap-3 rounded border p-3 text-sm">
+        {!slug && (
+          <div>
+            <Label htmlFor="log-fn-filter">Function</Label>
+            <Input
+              id="log-fn-filter"
+              className="w-44"
+              placeholder="All functions"
+              value={fnFilter}
+              onChange={(event: ChangeEvent<HTMLInputElement>) => setFnFilter(event.target.value)}
+            />
+          </div>
+        )}
+        <div>
+          <Label htmlFor="log-level-filter">Level</Label>
+          <select
+            id="log-level-filter"
+            className="block rounded border bg-background px-2 py-1.5"
+            value={level}
+            onChange={(event: ChangeEvent<HTMLSelectElement>) => setLevel(event.target.value)}
+          >
+            <option value="">All levels</option>
+            <option value="info">info</option>
+            <option value="warn">warn</option>
+            <option value="error">error</option>
+          </select>
+        </div>
+        <div>
+          <Label htmlFor="log-limit-filter">Limit</Label>
+          <select
+            id="log-limit-filter"
+            className="block rounded border bg-background px-2 py-1.5"
+            value={limit}
+            onChange={(event: ChangeEvent<HTMLSelectElement>) => setLimit(event.target.value)}
+          >
+            <option value="25">25</option>
+            <option value="50">50</option>
+            <option value="100">100</option>
+            <option value="200">200</option>
+          </select>
+        </div>
+        <Button size="tiny" variant="default" onClick={() => void query.refetch()}>
+          Refresh logs
+        </Button>
+        {query.data && (
+          <span className="ml-auto text-xs text-foreground-light">
+            Runtime stream: {query.data.runtime_connected ? 'Connected' : 'Unavailable (showing persisted history)'}
+          </span>
+        )}
+      </div>
+      {query.isPending && <p role="status">Loading logs…</p>}
+      {query.error && <p role="alert">{query.error.message}</p>}
+      {query.data && (
+        <div className="rounded border divide-y font-mono text-xs">
+          {query.data.logs.length === 0 ? (
+            <p className="p-4 font-sans text-sm text-foreground-light">No logs recorded yet.</p>
+          ) : (
+            query.data.logs.map((entry, idx) => (
+              <div key={`${entry.id}:${idx}`} className="p-2.5 flex flex-col gap-1">
+                <div className="flex flex-wrap items-center gap-2 text-foreground-light">
+                  <span>{entry.timestamp ? new Date(entry.timestamp).toLocaleString() : '-'}</span>
+                  <span className="font-semibold text-foreground">{entry.function_name}</span>
+                  <span className="uppercase">[{entry.level}]</span>
+                  <span>({entry.source})</span>
+                  {typeof entry.status === 'number' && <span>HTTP {entry.status}</span>}
+                  {typeof entry.duration_ms === 'number' && <span>{entry.duration_ms}ms</span>}
+                </div>
+                <div className="whitespace-pre-wrap break-all">{entry.message}</div>
+              </div>
+            ))
+          )}
+        </div>
+      )}
+    </div>
+  )
+}
