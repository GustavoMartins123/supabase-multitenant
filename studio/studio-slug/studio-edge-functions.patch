+        body: JSON.stringify({ revision: info.revision, expected_published_revision: info.published_revision }),
+      })
+      if (!mounted.current) return
+      setInfo(result)
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-function-versions', projectRef, result.name] })
+      toast.success('Function published for this project.')
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Publication failed')
+    } finally { if (mounted.current) setBusy(false) }
+  }
+
+  async function removeFunction(action: 'unpublish' | 'delete') {
+    if (!info) return
+    setBusy(true)
+    setFailure('')
+    const options = {
+      method: action === 'delete' ? 'DELETE' : 'POST',
+      body: JSON.stringify({ revision: info.revision, expected_published_revision: info.published_revision }),
+    }
+    try {
+      if (action === 'delete') {
+        await management<{ deleted: boolean }>(projectRef, `/${encodeURIComponent(name)}`, options)
+        if (!mounted.current) return
+        setDeleted(true)
+        toast.success('Function deleted from this project.')
+      } else {
+        const result = await management<FunctionBody>(projectRef, `/${encodeURIComponent(name)}/unpublish`, options)
+        if (!mounted.current) return
+        setInfo(result)
+        toast.success('Function unpublished. The saved draft is preserved.')
+      }
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-functions', projectRef] })
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Function removal failed')
+    } finally { if (mounted.current) setBusy(false) }
+  }
+
+  async function toggleVerifyJwt(nextValue: boolean) {
+    if (!info) return
+    setConfigBusy(true)
+    setFailure('')
+    try {
+      const result = await management<FunctionBody>(projectRef, `/${encodeURIComponent(name)}/config`, {
+        method: 'PUT',
+        body: JSON.stringify({ verify_jwt: nextValue }),
+      })
+      if (!mounted.current) return
+      setInfo(result)
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-functions', projectRef] })
+      toast.success(nextValue ? 'JWT verification enabled.' : 'JWT verification disabled (public webhook mode).')
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Configuration update failed')
+    } finally { if (mounted.current) setConfigBusy(false) }
+  }
+
+  async function runInvoke() {
+    if (!info) return
+    setInvoking(true)
+    setInvokeError('')
+    try {
+      let parsedHeaders: Record<string, string> = {}
+      if (invokeHeadersText.trim()) {
+        const raw = JSON.parse(invokeHeadersText)
+        if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+          throw new Error('Headers must be a JSON object')
+        }
+        for (const [k, v] of Object.entries(raw)) {
+          parsedHeaders[k] = String(v)
+        }
+      }
+      const noBody = invokeMethod === 'GET' || invokeMethod === 'HEAD'
+      const res = await management<InvokeResponse>(projectRef, `/${encodeURIComponent(name)}/invoke`, {
+        method: 'POST',
+        body: JSON.stringify({
+          method: invokeMethod,
+          path: invokePath || '/',
+          headers: parsedHeaders,
+          body: noBody ? null : invokeBodyText,
+          auth_mode: invokeAuthMode,
+        }),
+      })
+      if (!mounted.current) return
+      setInvokeResult(res)
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-logs', projectRef, name] })
+    } catch (error) {
+      if (mounted.current) setInvokeError(error instanceof Error ? error.message : 'Invocation failed')
+    } finally { if (mounted.current) setInvoking(false) }
+  }
+
+  async function rollbackRevision(targetRevision: string) {
+    if (!info) return
+    setRollingBackRev(targetRevision)
+    setFailure('')
+    try {
+      const result = await management<FunctionBody>(projectRef, `/${encodeURIComponent(name)}/rollback`, {
+        method: 'POST',
+        body: JSON.stringify({ revision: targetRevision, expected_revision: info.revision }),
+      })
+      if (!mounted.current) return
+      setInfo(result)
+      const reloaded = asFiles(result)
+      setFiles(reloaded)
+      setSaved(fingerprint(reloaded))
+      setSelected(0)
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-function-versions', projectRef, name] })
+      toast.success('Snapshot restored to draft. Review and publish explicitly when ready.')
+    } catch (error) {
+      if (mounted.current) setFailure(error instanceof Error ? error.message : 'Rollback failed')
+    } finally { if (mounted.current) setRollingBackRev(null) }
+  }
+
+  async function exportZip(versionSelector: string) {
+    if (!info) return
+    setDownloading(true)
+    try {
+      await downloadBundle(projectRef, info.name, versionSelector)
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : 'Bundle download failed')
+    } finally {
+      if (mounted.current) setDownloading(false)
+    }
+  }
+
+  if (deleted) return <p role="status" className="p-6">Function deleted. Returning to the function list…</p>
+
+  const activeLimits = info?.limits ?? (query.data && 'limits' in query.data ? query.data.limits : undefined)
+  const verifyJwt = info?.verify_jwt ?? true
+
+  return (
+    <div className="w-full flex flex-col min-h-[70vh]">
+      <div className="p-5 space-y-3 border-b">
+        <Link className="text-brand text-sm" href={`/project/${projectRef}/functions`}>Back to functions</Link>
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <h1 className="text-xl">{slug || info ? name : 'Create function'}</h1>
+          {info && (
+            <div className="flex flex-wrap gap-2">
+              <Button size="tiny" variant="default" disabled={downloading} onClick={() => void exportZip('draft')}>
+                Export Draft ZIP
+              </Button>
+              {info.published_revision && (
+                <Button size="tiny" variant="default" disabled={downloading} onClick={() => void exportZip('published')}>
+                  Export Published ZIP
+                </Button>
+              )}
+            </div>
+          )}
+        </div>
+        <p className="text-sm text-foreground-light">
+          Project: {projectRef}
+          {info && (
+            <>
+              {' · '}
+              {verifyJwt ? 'JWT verification: required' : 'JWT verification: disabled (public webhook)'}
+            </>
+          )}
+        </p>
+        {loaded && <BlockedNotice enabled={enabled} />}
+        {query.error && <p role="alert">{query.error.message}</p>}
+        {failure && <p role="alert">{failure}</p>}
+        {info?.published_revision && <p className="text-sm">
+          {info.revision === info.published_revision ? 'Published version' : 'Unpublished draft'}
+          {' · '}Public path: /{projectRef}/functions/v1/{name}
+        </p>}
+        {info && (
+          <div className="flex flex-wrap gap-2 pt-1">
+            {(['code', 'test', 'logs', 'versions', 'settings'] as const).map((item) => (
+              <Button
+                key={item}
+                size="tiny"
+                variant={tab === item ? undefined : 'default'}
+                onClick={() => setTab(item)}
+              >
+                {item === 'code'
+                  ? 'Code'
+                  : item === 'test'
+                    ? 'Test Runner'
+                    : item === 'logs'
+                      ? 'Logs'
+                      : item === 'versions'
+                        ? 'Versions'
+                        : 'Settings & Limits'}
+              </Button>
+            ))}
+          </div>
+        )}
+      </div>
+      {!loaded && !query.error && <p role="status" className="p-5">Loading editor…</p>}
+      {loaded && (!info || tab === 'code') && <>
+        <div inert={busy} className="flex flex-col flex-1 min-h-[450px]">
+          <FileExplorerAndEditor editable files={files} onFilesChange={setFiles} selectedFileId={selected} setSelectedFileId={setSelected} />
+        </div>
+        <div className="flex flex-wrap items-center justify-end gap-4 p-4 border-t">
+          {info && <>
+            <Button variant="danger" disabled={busy} onClick={() => setPendingAction('delete')}>Delete function</Button>
+            <Button variant="default" disabled={busy || !info.published_revision} onClick={() => setPendingAction('unpublish')}>Unpublish function</Button>
+          </>}
+          <Label htmlFor="local-function-name">Function name</Label>
+          <Input id="local-function-name" className="w-64" value={name} disabled={!!slug || !!info || busy}
+            onChange={(event: ChangeEvent<HTMLInputElement>) => setName(event.target.value)} placeholder="my-function" />
+          <Button variant="default" loading={busy} disabled={busy || !validName || !files.length} onClick={save}>Save draft</Button>
+          <Button disabled={busy || !enabled || !info?.revision || dirty || info.revision === info.published_revision} onClick={publish}>Publish function</Button>
+        </div>
+      </>}
+      {loaded && info && tab === 'test' && (
+        <div className="p-5 space-y-4">
+          {!info.published_revision && (
+            <p role="status" className="rounded border border-warning p-3 text-sm">
+              This function has no published revision yet. Publish it before invoking via the test runner.
+            </p>
+          )}
+          {info.published_revision && info.revision !== info.published_revision && (
+            <p role="status" className="rounded border border-warning p-3 text-sm">
+              Your saved draft ({info.revision?.slice(0, 12)}) differs from the published version ({info.published_revision.slice(0, 12)}). Live invocations execute the published version.
+            </p>
+          )}
+          <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
+            <div>
+              <Label htmlFor="invoke-method">Method</Label>
+              <select
+                id="invoke-method"
+                className="block w-full rounded border bg-background px-2 py-2 text-sm"
+                value={invokeMethod}
+                onChange={(event: ChangeEvent<HTMLSelectElement>) => setInvokeMethod(event.target.value)}
+              >
+                {['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'HEAD', 'OPTIONS'].map((m) => (
+                  <option key={m} value={m}>{m}</option>
+                ))}
+              </select>
+            </div>
+            <div>
+              <Label htmlFor="invoke-path">Path & Query</Label>
+              <Input
+                id="invoke-path"
+                value={invokePath}
+                onChange={(event: ChangeEvent<HTMLInputElement>) => setInvokePath(event.target.value)}
+                placeholder="/items?filter=active"
+              />
+            </div>
+            <div>
+              <Label htmlFor="invoke-auth">Authentication Mode</Label>
+              <select
+                id="invoke-auth"
+                className="block w-full rounded border bg-background px-2 py-2 text-sm"
+                value={invokeAuthMode}
+                onChange={(event: ChangeEvent<HTMLSelectElement>) => setInvokeAuthMode(event.target.value)}
+              >
+                <option value="anon">Project Anon Role</option>
+                <option value="service_role">Project Service Role</option>
+                <option value="none">Unauthenticated (Webhook / Public)</option>
+                <option value="custom">Custom Headers Only</option>
+              </select>
+            </div>
+          </div>
+          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+            <div>
+              <Label htmlFor="invoke-headers">Headers (JSON)</Label>
+              <textarea
+                id="invoke-headers"
+                rows={5}
+                className="mt-1 w-full rounded border bg-background p-2 font-mono text-xs"
+                value={invokeHeadersText}
+                onChange={(event: ChangeEvent<HTMLTextAreaElement>) => setInvokeHeadersText(event.target.value)}
+              />
+            </div>
+            <div>
+              <Label htmlFor="invoke-body">Request Body</Label>
+              <textarea
+                id="invoke-body"
+                rows={5}
+                disabled={invokeMethod === 'GET' || invokeMethod === 'HEAD'}
+                className="mt-1 w-full rounded border bg-background p-2 font-mono text-xs"
+                value={invokeBodyText}
+                onChange={(event: ChangeEvent<HTMLTextAreaElement>) => setInvokeBodyText(event.target.value)}
+              />
+            </div>
+          </div>
+          <div className="flex justify-end">
+            <Button
+              loading={invoking}
+              disabled={invoking || !enabled || !info.published_revision}
+              onClick={() => void runInvoke()}
+            >
+              Invoke Published Function
+            </Button>
+          </div>
+          {invokeError && <p role="alert" className="text-sm text-destructive">{invokeError}</p>}
+          {invokeResult && (
+            <div className="rounded border p-4 space-y-3 text-sm">
+              <div className="flex flex-wrap items-center gap-3">
+                <span className="font-mono font-semibold">HTTP {invokeResult.status}</span>
+                <span>{invokeResult.duration_ms}ms</span>
+                <span className="font-mono text-xs text-foreground-light">Request ID: {invokeResult.request_id}</span>
+                {invokeResult.stale_draft_warning && (
+                  <span className="rounded border border-warning px-2 py-0.5 text-xs">Executed published revision</span>
+                )}
+                {invokeResult.truncated && (
+                  <span className="rounded border px-2 py-0.5 text-xs">Response body truncated to 256 KB</span>
+                )}
+              </div>
+              <pre className="max-h-80 overflow-auto rounded bg-surface-200 p-3 font-mono text-xs">{invokeResult.body}</pre>
+            </div>
+          )}
+        </div>
+      )}
+      {loaded && info && tab === 'logs' && (
+        <div className="p-5">
+          <LogsPanel projectRef={projectRef} slug={info.name} />
+        </div>
+      )}
+      {loaded && info && tab === 'versions' && (
+        <div className="p-5 space-y-4">
+          {versionsQuery.isPending && <p role="status">Loading versions…</p>}
+          {versionsQuery.error && <p role="alert">{versionsQuery.error.message}</p>}
+          {versionsQuery.data && (
+            <div className="rounded border divide-y text-sm">
+              {versionsQuery.data.versions.map((ver) => (
+                <div key={ver.revision} className="flex flex-wrap items-center justify-between gap-2 p-3">
+                  <div className="space-y-0.5">
+                    <div className="flex flex-wrap items-center gap-2">
+                      <span className="font-mono font-medium">{ver.revision.slice(0, 12)}</span>
+                      {ver.is_published && <span className="rounded border px-2 py-0.5 text-xs">Published</span>}
+                      {ver.is_draft && <span className="rounded border px-2 py-0.5 text-xs">Current Draft</span>}
+                    </div>
+                    <div className="text-xs text-foreground-light">
+                      {ver.created_at ? new Date(ver.created_at).toLocaleString() : 'Legacy'} · {ver.file_count} files · {ver.total_bytes} bytes
+                    </div>
+                  </div>
+                  <div className="flex gap-2">
+                    <Button
+                      size="tiny"
+                      variant="default"
+                      disabled={downloading}
+                      onClick={() => void exportZip(ver.revision)}
+                    >
+                      Download ZIP
+                    </Button>
+                    {!ver.is_draft && (
+                      <Button
+                        size="tiny"
+                        variant="default"
+                        loading={rollingBackRev === ver.revision}
+                        disabled={rollingBackRev !== null || dirty}
+                        onClick={() => void rollbackRevision(ver.revision)}
+                      >
+                        Restore to draft
+                      </Button>
+                    )}
+                  </div>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      )}
+      {loaded && info && tab === 'settings' && (
+        <div className="p-5 space-y-5">
+          <div className="rounded border p-4 space-y-3 text-sm">
+            <div className="flex flex-wrap items-center justify-between gap-3">
+              <div>
+                <h2 className="font-medium">JWT & Webhook Authentication</h2>
+                <p className="text-foreground-light">
+                  Disable JWT enforcement only for webhooks or public endpoints that verify provider signatures in function code.
+                </p>
+              </div>
+              <Button
+                variant={verifyJwt ? 'default' : 'danger'}
+                loading={configBusy}
+                disabled={configBusy}
+                onClick={() => void toggleVerifyJwt(!verifyJwt)}
+              >
+                {verifyJwt ? 'Disable JWT Verification' : 'Enable JWT Verification'}
+              </Button>
+            </div>
+            <p className="font-mono text-xs">Endpoint path: /{projectRef}/functions/v1/{info.name}</p>
+          </div>
+          <LimitsSummary limits={activeLimits} projectRef={projectRef} />
+        </div>
+      )}
+      <DiscardChangesConfirmationDialog visible={pendingAction !== null}
+        title={`${pendingAction === 'delete' ? 'Delete' : 'Unpublish'} function "${name}"?`}
+        description={pendingAction === 'delete'
+          ? `This removes the saved function and stops its public endpoint. Other functions are preserved.${dirty ? ' Unsaved changes in this editor will be discarded.' : ''}`
+          : 'The public endpoint will stop serving this function. Your saved draft and unsaved editor changes are preserved.'}
+        confirmLabel={pendingAction === 'delete' ? 'Delete function' : 'Unpublish function'} cancelLabel="Cancel"
+        onCancel={() => setPendingAction(null)} onClose={() => {
+          const action = pendingAction
+          setPendingAction(null)
+          if (action) void removeFunction(action)
+        }} />
+      <DiscardChangesConfirmationDialog visible={navigation.shouldConfirmNavigation}
+        onCancel={navigation.handleCancelNavigation} onClose={navigation.handleConfirmNavigation} />
+    </div>
+  )
+}
+
+export const SelfHostedEdgeFunctionsPage: NextPageWithLayout = () => {
+  const { ref, functionSlug } = useParams()
+  const router = useRouter()
+  if (!ref) return <p role="alert">A project context is required.</p>
+  const isEditor = router.pathname !== '/project/[ref]/functions'
+  return isEditor
+    ? <FunctionEditor key={`${ref}:${functionSlug ?? 'new'}`} projectRef={ref} slug={functionSlug} />
+    : <FunctionsList key={ref} projectRef={ref} />
+}
+SelfHostedEdgeFunctionsPage.getLayout = (page: ReactNode) => (
+  <DefaultLayout><EdgeFunctionsLayout title="Edge Functions">{page}</EdgeFunctionsLayout></DefaultLayout>
+)

