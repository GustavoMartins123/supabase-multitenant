+function LimitsSummary({ limits, projectRef }: { limits?: GovernanceLimits; projectRef: string }) {
+  const queryClient = useQueryClient()
+  const [gcBusy, setGcBusy] = useState(false)
+  const [savingQuotas, setSavingQuotas] = useState(false)
+  const [resetBusy, setResetBusy] = useState(false)
+  const [ackBusyId, setAckBusyId] = useState<number | null>(null)
+  const [quotaError, setQuotaError] = useState('')
+  const [draftQuotas, setDraftQuotas] = useState<Record<string, string>>({})
+  const [dirtyQuotas, setDirtyQuotas] = useState(false)
+
+  useEffect(() => {
+    setDirtyQuotas(false)
+    setDraftQuotas({})
+  }, [projectRef])
+
+  const quotasQuery = useQuery({
+    queryKey: ['local-edge-quotas', projectRef],
+    queryFn: ({ signal }) => management<QuotasResponse>(projectRef, '/quotas', { signal }),
+    retry: false,
+    refetchOnWindowFocus: false,
+    gcTime: 0,
+  })
+
+  const alertsQuery = useQuery({
+    queryKey: ['local-edge-alerts', projectRef],
+    queryFn: ({ signal }) => management<AlertsResponse>(projectRef, '/alerts', { signal }),
+    retry: false,
+    refetchOnWindowFocus: false,
+    gcTime: 0,
+  })
+
+  useEffect(() => {
+    if (!quotasQuery.data?.quotas || dirtyQuotas) return
+    const nextDraft: Record<string, string> = {}
+    const qMap = quotasQuery.data.quotas
+    for (const meta of QUOTA_FIELD_META) {
+      const val = qMap[meta.key]
+      if (typeof val === 'number') nextDraft[meta.key] = String(val)
+    }
+    setDraftQuotas(nextDraft)
+  }, [quotasQuery.data, dirtyQuotas])
+
+  const effectiveLimits = quotasQuery.data?.quotas ?? limits
+  if (!effectiveLimits) return null
+
+  async function refreshQuotaQueries() {
+    await Promise.all([
+      queryClient.invalidateQueries({ queryKey: ['local-edge-quotas', projectRef] }),
+      queryClient.invalidateQueries({ queryKey: ['local-edge-alerts', projectRef] }),
+      queryClient.invalidateQueries({ queryKey: ['local-edge-functions', projectRef] }),
+      queryClient.invalidateQueries({ queryKey: ['local-edge-function', projectRef] }),
+    ])
+  }
+
+  async function runGc() {
+    setGcBusy(true)
+    try {
+      const res = await management<{ removed_count: number; reclaimed_bytes: number; kept_count: number }>(
+        projectRef,
+        '/gc',
+        { method: 'POST', body: JSON.stringify({}) }
+      )
+      toast.success(`Version cleanup complete: ${res.removed_count} removed, ${res.kept_count} retained.`)
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : 'Version cleanup failed')
+    } finally {
+      setGcBusy(false)
+    }
+  }
+
+  async function saveCustomQuotas() {
+    setSavingQuotas(true)
+    setQuotaError('')
+    try {
+      const payload: Record<string, number> = {}
+      const currentMap = quotasQuery.data?.quotas
+      for (const meta of QUOTA_FIELD_META) {
+        const raw = draftQuotas[meta.key]
+        if (raw === undefined || raw.trim() === '') continue
+        const parsed = Number.parseInt(raw.trim(), 10)
+        if (!Number.isInteger(parsed)) {
+          throw new Error(`${meta.label} must be an integer`)
+        }
+        if (parsed !== currentMap?.[meta.key]) {
+          payload[meta.key] = parsed
+        }
+      }
+      if (Object.keys(payload).length === 0) {
+        toast.info('No quota changes to apply.')
+        return
+      }
+      await management<QuotasResponse>(projectRef, '/quotas', {
+        method: 'PUT',
+        body: JSON.stringify(payload),
+      })
+      toast.success('Project Edge Functions quotas updated.')
+      setDirtyQuotas(false)
+      await refreshQuotaQueries()
+    } catch (error) {
+      setQuotaError(error instanceof Error ? error.message : 'Failed to save custom quotas')
+    } finally {
+      setSavingQuotas(false)
+    }
+  }
+
+  async function resetQuotas() {
+    setResetBusy(true)
+    setQuotaError('')
+    try {
+      await management<QuotasResponse>(projectRef, '/quotas', {
+        method: 'PUT',
+        body: JSON.stringify({ reset_defaults: true }),
+      })
+      toast.success('Project quotas reset to platform defaults.')
+      setDirtyQuotas(false)
+      await refreshQuotaQueries()
+    } catch (error) {
+      setQuotaError(error instanceof Error ? error.message : 'Failed to reset quotas')
+    } finally {
+      setResetBusy(false)
+    }
+  }
+
+  async function acknowledgeEvent(eventId: number) {
+    setAckBusyId(eventId)
+    try {
+      await management(projectRef, `/alerts/${eventId}/ack`, {
+        method: 'POST',
+        body: JSON.stringify({}),
+      })
+      toast.success('Alert acknowledged.')
+      await queryClient.invalidateQueries({ queryKey: ['local-edge-alerts', projectRef] })
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : 'Failed to acknowledge alert')
+    } finally {
+      setAckBusyId(null)
+    }
+  }
+
+  const activeAlerts = alertsQuery.data?.active_alerts ?? quotasQuery.data?.active_alerts ?? []
+  const events = alertsQuery.data?.events ?? []
+  const usage = quotasQuery.data?.usage
+  const util = quotasQuery.data?.utilization_pct
+
+  return (
+    <div className="space-y-4">
+      {activeAlerts.length > 0 && (
+        <div role="status" className="rounded border border-warning p-4 space-y-2 text-sm">
+          <div className="font-medium">Active Quota & Saturation Alerts</div>
+          {activeAlerts.map((alert, idx) => (
+            <div key={`${alert.metric}:${idx}`} className="flex flex-wrap items-center justify-between gap-2 text-xs">
+              <span>
+                <span className="uppercase font-semibold mr-2">[{alert.severity}]</span>
+                {alert.message}
+              </span>
+              <span className="font-mono text-foreground-light">{alert.utilization_pct}%</span>
+            </div>
+          ))}
+        </div>
+      )}
+
+      <div className="rounded border p-4 space-y-4 text-sm">
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <div>
+            <h2 className="font-medium">Runtime & Storage Quotas</h2>
+            <p className="text-xs text-foreground-light">
+              Project admins may tighten limits or adjust alert thresholds; raising limits above platform defaults requires a global admin.
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            {quotasQuery.data?.customized && (
+              <Button size="tiny" variant="default" loading={resetBusy} disabled={resetBusy || savingQuotas} onClick={() => void resetQuotas()}>
+                Reset Defaults
+              </Button>
+            )}
+            <Button size="tiny" variant="default" loading={gcBusy} disabled={gcBusy} onClick={runGc}>
+              Prune old snapshots
+            </Button>
+          </div>
+        </div>
+
+        {usage && util && (
+          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 rounded bg-surface-200 p-3 text-xs">
+            <div>
+              <div className="text-foreground-light">Functions</div>
+              <div className="font-mono font-medium">
+                {usage.functions_count} / {effectiveLimits.max_functions} ({util.functions}%)
+              </div>
+            </div>
+            <div>
+              <div className="text-foreground-light">Largest bundle</div>
+              <div className="font-mono font-medium">
+                {usage.largest_function_bytes} B ({util.largest_bundle_bytes}%)
+              </div>
+            </div>
+            <div>
+              <div className="text-foreground-light">Secrets</div>
+              <div className="font-mono font-medium">
+                {usage.secrets_count} / {effectiveLimits.max_secrets} ({util.secrets}%)
+              </div>
+            </div>
+            <div>
+              <div className="text-foreground-light">Recent 429s</div>
+              <div className="font-mono font-medium">{usage.recent_429_count}</div>
+            </div>
+          </div>
+        )}
+
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
+          {QUOTA_FIELD_META.map((meta) => {
+            const bound = quotasQuery.data?.bounds?.[meta.key]
+            return (
+              <div key={meta.key} className="space-y-1">
+                <Label htmlFor={`quota-${meta.key}`}>
+                  {meta.label}
+                  {meta.unit ? ` (${meta.unit})` : ''}
+                </Label>
+                <Input
+                  id={`quota-${meta.key}`}
+                  type="number"
+                  min={bound?.min}
+                  max={bound?.max}
+                  value={draftQuotas[meta.key] ?? ''}
+                  disabled={savingQuotas || resetBusy || quotasQuery.isPending || Boolean(quotasQuery.error) || !quotasQuery.data}
+                  onChange={(event: ChangeEvent<HTMLInputElement>) => {
+                    setDirtyQuotas(true)
+                    setDraftQuotas((prev) => ({ ...prev, [meta.key]: event.target.value }))
+                  }}
+                />
+                {bound && (
+                  <p className="text-[11px] text-foreground-light">
+                    Range: {bound.min}–{bound.max} (default {bound.default})
+                  </p>
+                )}
+              </div>
+            )
+          })}
+        </div>
+
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <span className="text-xs text-foreground-light">
+            Global runtime ceiling concurrency: {effectiveLimits.max_concurrent_global} · Single secret max: {effectiveLimits.max_secret_value_bytes} B
+          </span>
+          <Button
+            size="tiny"
+            loading={savingQuotas}
+            disabled={savingQuotas || resetBusy || quotasQuery.isPending || Boolean(quotasQuery.error) || !quotasQuery.data}
+            onClick={() => void saveCustomQuotas()}
