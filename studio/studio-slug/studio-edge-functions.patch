+async function downloadBundle(ref: string, slug: string, versionSelector: string): Promise<void> {
+  const response = await fetch(
+    `${BASE_PATH}/api/platform/projects/${encodeURIComponent(ref)}/edge-functions/${encodeURIComponent(slug)}/download?version=${encodeURIComponent(versionSelector)}`,
+    {
+      method: 'GET',
+      credentials: 'same-origin',
+      redirect: 'manual',
+      cache: 'no-store',
+      headers: { 'X-Studio-Project-Ref': ref },
+    }
+  )
+  if (response.redirected) {
+    throw new Error('Your Studio session must be renewed.')
+  }
+  if (!response.ok) {
+    let message = 'Bundle download failed'
+    try {
+      const data = await response.json()
+      if (typeof data?.detail === 'string') message = data.detail
+    } catch {}
+    throw new Error(message)
+  }
+  const blob = await response.blob()
+  const objectUrl = URL.createObjectURL(blob)
+  try {
+    const link = document.createElement('a')
+    link.href = objectUrl
+    link.download = `${slug}-${versionSelector.slice(0, 12)}.zip`
+    document.body.appendChild(link)
+    link.click()
+    link.remove()
+  } finally {
+    URL.revokeObjectURL(objectUrl)
+  }
+}
