+    queryKey: ['local-edge-secrets', projectRef],
+    queryFn: ({ signal }) => management<SecretsResponse>(projectRef, '/secrets', { signal }),
+    retry: false,
+    gcTime: 0,
+  })
+
+  async function saveSecret() {
+    if (!secretName.trim() || !secretValue) return
+    setSaving(true)
+    setErrorMsg('')
+    try {
+      const res = await management<SecretsResponse & { runtime_synced?: boolean }>(projectRef, '/secrets', {
+        method: 'PUT',
+        body: JSON.stringify({ secrets: [{ name: secretName.trim(), value: secretValue }] }),
+      })
+      setSecretName('')
+      setSecretValue('')
+      toast.success(res.runtime_synced ? 'Secret saved and synced to runtime.' : 'Secret encrypted and saved.')
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-secrets', projectRef] })
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-quotas', projectRef] })
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-alerts', projectRef] })
+    } catch (error) {
+      setErrorMsg(error instanceof Error ? error.message : 'Failed to save secret')
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  async function removeSecret(name: string) {
+    setDeletingName(name)
+    setErrorMsg('')
+    try {
+      await management(projectRef, `/secrets/${encodeURIComponent(name)}`, { method: 'DELETE' })
+      toast.success(`Secret ${name} deleted.`)
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-secrets', projectRef] })
+      void queryClient.invalidateQueries({ queryKey: ['local-edge-quotas', projectRef] })
+    } catch (error) {
+      setErrorMsg(error instanceof Error ? error.message : 'Failed to delete secret')
+    } finally {
+      setDeletingName(null)
+    }
+  }
+
+  return (
+    <div className="space-y-4">
+      <div className="rounded border p-4 space-y-3">
+        <h2 className="font-medium">Project Edge Secrets</h2>
+        <p className="text-sm text-foreground-light">
+          Secrets are encrypted per project and injected into Deno.env at runtime. Existing values are never displayed again after saving.
+        </p>
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
+          <div>
+            <Label htmlFor="edge-secret-name">Name</Label>
+            <Input
+              id="edge-secret-name"
+              placeholder="STRIPE_WEBHOOK_SECRET"
+              value={secretName}
+              disabled={saving}
+              onChange={(event: ChangeEvent<HTMLInputElement>) => setSecretName(event.target.value)}
+            />
+          </div>
+          <div>
+            <Label htmlFor="edge-secret-value">Value</Label>
+            <Input
+              id="edge-secret-value"
+              type="password"
+              autoComplete="new-password"
+              placeholder="Enter secret value"
+              value={secretValue}
+              disabled={saving}
+              onChange={(event: ChangeEvent<HTMLInputElement>) => setSecretValue(event.target.value)}
+            />
+          </div>
+          <div>
+            <Button
+              loading={saving}
+              disabled={saving || !secretName.trim() || !secretValue}
+              onClick={saveSecret}
+            >
+              Save / Rotate secret
+            </Button>
+          </div>
+        </div>
+        {errorMsg && <p role="alert" className="text-sm text-destructive">{errorMsg}</p>}
+      </div>
+      {query.isPending && <p role="status">Loading secrets…</p>}
+      {query.error && <p role="alert">{query.error.message}</p>}
+      {query.data && (
+        <div className="rounded border divide-y">
+          {query.data.secrets.length === 0 ? (
+            <p className="p-4 text-sm text-foreground-light">No custom secrets configured for this project.</p>
+          ) : (
+            query.data.secrets.map((secret) => (
+              <div key={secret.name} className="flex flex-wrap items-center justify-between gap-2 p-3 text-sm">
+                <div>
+                  <span className="font-mono font-medium">{secret.name}</span>
+                  <span className="ml-3 text-foreground-light">
+                    Updated: {new Date(secret.updated_at).toLocaleString()}
+                  </span>
+                </div>
+                <Button
+                  size="tiny"
+                  variant="danger"
+                  disabled={deletingName === secret.name}
+                  loading={deletingName === secret.name}
+                  onClick={() => removeSecret(secret.name)}
+                >
+                  Delete
+                </Button>
+              </div>
+            ))
+          )}
+        </div>
+      )}
+    </div>
+  )
+}
