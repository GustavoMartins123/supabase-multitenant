+function FunctionsList({ projectRef }: { projectRef: string }) {
+  const [tab, setTab] = useState<'functions' | 'secrets' | 'logs' | 'schedules' | 'quotas'>('functions')
+  const query = useQuery({
+    queryKey: ['local-edge-functions', projectRef],
+    queryFn: ({ signal }) => management<FunctionList>(projectRef, '', { signal }),
+    retry: false,
+    gcTime: 0,
+  })
+  const publishedFunctions = (query.data?.functions ?? []).filter((fn) => !!fn.published_revision).map((fn) => fn.name)
+
+  return (
+    <div className="p-6 space-y-5 w-full max-w-6xl mx-auto">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <h1 className="text-xl">Edge Functions</h1>
+        {query.data && (
+          <Button asChild><Link href={`/project/${projectRef}/functions/new`}>Create function</Link></Button>
+        )}
+      </div>
+      <div className="flex flex-wrap gap-2 border-b pb-2 text-sm">
+        {(['functions', 'secrets', 'logs', 'schedules', 'quotas'] as const).map((item) => (
+          <Button
+            key={item}
+            size="tiny"
+            variant={tab === item ? undefined : 'default'}
+            onClick={() => setTab(item)}
+          >
+            {item === 'functions'
+              ? 'Functions'
+              : item === 'secrets'
+                ? 'Secrets'
+                : item === 'logs'
+                  ? 'Logs'
+                  : item === 'schedules'
+                    ? 'Schedules'
+                    : 'Limits & GC'}
+          </Button>
+        ))}
+      </div>
+      {query.isPending && <p role="status">Loading functions…</p>}
+      {query.error && <p role="alert">{query.error.message}</p>}
+      {query.data && tab === 'functions' && <>
+        <BlockedNotice enabled={query.data.enabled} />
+        <p className="text-sm text-foreground-light">Project: {projectRef}</p>
+        {query.data.functions.length === 0 && <p>No functions yet.</p>}
+        <ul className="divide-y border rounded">
+          {query.data.functions.map((item) => (
+            <li key={item.name} className="flex flex-wrap items-center justify-between gap-2 p-4">
+              <div className="flex items-center gap-3">
+                <Link className="text-brand" href={`/project/${projectRef}/functions/${item.name}/code`}>
+                  {item.name}
+                </Link>
+                {item.verify_jwt === false && (
+                  <span className="rounded border px-2 py-0.5 text-xs">Webhook (verify_jwt=false)</span>
+                )}
+              </div>
+              <span className="text-sm text-foreground-light">
+                {!item.published_revision ? 'Draft' : item.revision !== item.published_revision ? 'Unpublished changes' : 'Published'}
+              </span>
+            </li>
+          ))}
+        </ul>
+      </>}
+      {tab === 'secrets' && <SecretsPanel projectRef={projectRef} />}
+      {tab === 'logs' && <LogsPanel projectRef={projectRef} />}
+      {tab === 'schedules' && (
+        <SchedulesPanel
+          projectRef={projectRef}
+          enabled={query.data?.enabled ?? false}
+          publishedFunctions={publishedFunctions}
+        />
+      )}
+      {query.data && tab === 'quotas' && <LimitsSummary limits={query.data.limits} projectRef={projectRef} />}
