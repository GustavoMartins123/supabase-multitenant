+// The upstream useMonaco hook leaves its canceled initialization promise
+// unhandled when an editor unmounts during loading. Handle that lifecycle here
+// and surface genuine initialization failures through the error boundary.
+function useEditorMonaco() {
+  const [instance, setInstance] = useState<Monaco | null>(() => loader.__getMonacoInstance())
+  const [failure, setFailure] = useState<Error | null>(null)
+  useEffect(() => {
+    if (instance) return
+    let mounted = true
+    const initialization = loader.init()
+    initialization.then((loaded) => {
+      if (mounted) setInstance(loaded)
+    }).catch((error) => {
+      if (mounted && error?.type !== 'cancelation') {
+        setFailure(error instanceof Error ? error : new Error('Monaco initialization failed', { cause: error }))
+      }
+    })
+    return () => {
+      mounted = false
+      initialization.cancel()
+    }
+  }, [instance])
+  if (failure) throw failure
+  return instance
+}
