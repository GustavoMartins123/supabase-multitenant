+import { act, renderHook } from '@testing-library/react'
+import { StrictMode, type PropsWithChildren } from 'react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { useCreateSqlDraft } from './useCreateSqlDraft'
+
+const fixture = vi.hoisted(() => ({
+  params: { ref: 'abcdefghijklmnopqrst', id: 'new', content: undefined as string | undefined },
+  router: { isReady: true, replace: vi.fn(async (..._args: unknown[]) => true) },
+  project: { id: 1 }, profile: { id: 1 },
+  state: { addSnippet: vi.fn(), addNeedsSaving: vi.fn() },
+  tabs: { addTab: vi.fn() }, toast: { error: vi.fn() },
+}))
+vi.mock('common', () => ({ useParams: () => fixture.params }))
+vi.mock('next/router', () => ({ useRouter: () => fixture.router }))
+vi.mock('sonner', () => ({ toast: fixture.toast }))
+vi.mock('@/hooks/misc/useSelectedProject', () => ({ useSelectedProjectQuery: () => ({ data: fixture.project }) }))
+vi.mock('@/lib/profile', () => ({ useProfile: () => ({ profile: fixture.profile }) }))
+vi.mock('@/state/sql-editor-v2', () => ({ useSqlEditorV2StateSnapshot: () => fixture.state }))
+vi.mock('@/state/tabs', () => ({ useTabsStateSnapshot: () => fixture.tabs, createTabId: (_type: string, { id }: { id: string }) => `sql-${id}` }))
+vi.mock('./SQLEditor.constants', () => ({ generateSnippetTitle: () => 'Untitled query' }))
+vi.mock('./SQLEditor.utils', () => ({ createSqlSnippetSkeletonV2: (options: object) => ({ ...options, id: crypto.randomUUID() }) }))
+
+describe('SQL draft tabs', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    fixture.params.id = 'new'
+    fixture.params.content = undefined
+    fixture.router.replace.mockResolvedValue(true)
+  })
+  it('creates and queues an empty query once, with a permanent canonical tab', () => {
+    const wrapper = ({ children }: PropsWithChildren) => <StrictMode>{children}</StrictMode>
+    renderHook(useCreateSqlDraft, { wrapper })
+    expect(fixture.state.addSnippet).toHaveBeenCalledTimes(1)
+    const { snippet } = fixture.state.addSnippet.mock.calls[0][0]
+    expect(snippet.sql).toBe('')
+    expect(fixture.state.addNeedsSaving).toHaveBeenCalledWith(snippet.id)
+    expect(fixture.tabs.addTab).toHaveBeenCalledWith(expect.objectContaining({ id: `sql-${snippet.id}`, isPreview: false, metadata: { sqlId: snippet.id, name: snippet.name } }))
+    expect(fixture.router.replace).toHaveBeenCalledWith(`/project/abcdefghijklmnopqrst/sql/${snippet.id}`, undefined, { shallow: true })
+  })
+  it('keeps a draft when visiting another query and creates a distinct next draft', () => {
+    const { rerender } = renderHook(useCreateSqlDraft)
+    const first = fixture.state.addSnippet.mock.calls[0][0].snippet.id
+    fixture.params.id = 'existing-query'
+    rerender()
+    expect(fixture.tabs.addTab).toHaveBeenCalledTimes(1)
+    fixture.params.id = 'new'
+    rerender()
+    const second = fixture.state.addSnippet.mock.calls[1][0].snippet.id
+    expect(second).not.toBe(first)
+    expect(fixture.tabs.addTab).toHaveBeenCalledTimes(2)
+  })
+  it('consumes deep-linked SQL without executing it', () => {
+    fixture.params.content = 'select 42'
+    renderHook(useCreateSqlDraft)
+    expect(fixture.state.addSnippet.mock.calls[0][0].snippet.sql).toBe('select 42')
+    expect(fixture.router.replace.mock.calls[0][0]).not.toContain('content=')
+  })
+  it('reports navigation failure without generating another draft', async () => {
+    fixture.router.replace.mockRejectedValueOnce(new Error('Navigation unavailable'))
+    const { rerender } = renderHook(useCreateSqlDraft)
+    await act(async () => {})
+    rerender()
+    expect(fixture.toast.error).toHaveBeenCalledTimes(1)
+    expect(fixture.state.addSnippet).toHaveBeenCalledTimes(1)
+  })
+})
