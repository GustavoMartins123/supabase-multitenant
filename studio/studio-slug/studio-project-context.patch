+import { renderHook } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+import { useSqlEditorTabsCleanup } from './Tabs.utils'
+
+const fixture = vi.hoisted(() => ({
+  tabsMap: { 'sql-draft': { id: 'sql-draft', type: 'sql', label: 'Empty draft', metadata: { sqlId: 'draft' } },
+             'sql-saved': { id: 'sql-saved', type: 'sql', label: 'Old title', metadata: { sqlId: 'saved' } } },
+  openTabs: ['sql-draft', 'sql-saved'], updateTab: vi.fn(), removeTabs: vi.fn(),
+  removeRecentItems: vi.fn(), getRecentItemsByType: vi.fn(() => []),
+}))
+vi.mock('@/state/tabs', () => ({ useTabsStateSnapshot: () => fixture, editorEntityTypes: { sql: ['sql'] }, createTabId: () => '' }))
+describe('SQL tab list reconciliation', () => {
+  it('never discards drafts or tabs absent from a paginated response', () => {
+    const { result } = renderHook(useSqlEditorTabsCleanup)
+    result.current({ snippets: [{ id: 'saved', type: 'sql', name: 'New title' }] })
+    result.current({ snippets: [] })
+    expect(fixture.removeTabs).not.toHaveBeenCalled()
+    expect(fixture.removeRecentItems).not.toHaveBeenCalled()
+    expect(fixture.updateTab).toHaveBeenCalledWith('sql-saved', { label: 'New title' })
+  })
+})
