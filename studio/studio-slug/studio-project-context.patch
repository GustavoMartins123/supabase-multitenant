diff --git a/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx b/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx
new file mode 100644
--- /dev/null
+++ b/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx
@@ -0,0 +1,95 @@
+import { useQueryClient } from '@tanstack/react-query'
+import { Settings } from 'lucide-react'
+import { useEffect, useState } from 'react'
+import { Button, Dialog, DialogContent, DialogHeader, DialogTitle } from 'ui'
+import { toast } from 'sonner'
+
+import { fetchHandler } from '@/data/fetchers'
+import { useSelectedProjectQuery } from '@/hooks/misc/useSelectedProject'
+import { BASE_PATH } from '@/lib/constants'
+
+type SettingsState = {
+  hasKey: boolean
+  provider?: 'openai' | 'openrouter'
+  model?: string
+  permission?: 'none' | 'schema' | 'read' | 'write' | 'full'
+  maxPermission: 'none' | 'full'
+}
+
+export function SelfHostedAssistantSettings() {
+  const { data: project } = useSelectedProjectQuery()
+  const queryClient = useQueryClient()
+  const [open, setOpen] = useState(false)
+  const [status, setStatus] = useState<SettingsState>()
+  const [provider, setProvider] = useState<'openai' | 'openrouter'>('openai')
+  const [model, setModel] = useState('')
+  const [permission, setPermission] = useState<'none' | 'schema' | 'read' | 'write' | 'full'>('none')
+  const [apiKey, setApiKey] = useState('')
+  const [changingKey, setChangingKey] = useState(false)
+  const [saving, setSaving] = useState(false)
+
+  useEffect(() => {
+    setApiKey('')
+    setStatus(undefined)
+    setChangingKey(false)
+    if (!open || !project?.ref) return
+    const controller = new AbortController()
+    fetchHandler(`${BASE_PATH}/api/ai/settings`, { signal: controller.signal, cache: 'no-store' })
+      .then(async response => {
+        if (!response.ok) throw new Error('Unable to load assistant settings')
+        const data: SettingsState = await response.json()
+        if (controller.signal.aborted) return
+        setStatus(data)
+        setProvider(data.provider ?? 'openai')
+        setModel(data.model ?? '')
+        setPermission(data.permission ?? 'none')
+      })
+      .catch(() => { if (!controller.signal.aborted) toast.error('Unable to load assistant settings') })
+    return () => { controller.abort(); setApiKey('') }
+  }, [open, project?.ref])
+
+  const save = async () => {
+    if (!status || !project?.ref || window.location.protocol !== 'https:') return
+    setSaving(true)
+    try {
+      const response = await fetchHandler(`${BASE_PATH}/api/ai/settings`, {
+        method: 'PUT', headers: { 'Content-Type': 'application/json' }, cache: 'no-store',
+        body: JSON.stringify({ provider, model, permission, ...(apiKey ? { apiKey } : {}) }),
+      })
+      if (!response.ok) throw new Error('Unable to save assistant settings')
+      await queryClient.invalidateQueries({ queryKey: ['api-key'] })
+      setChangingKey(false)
+      setOpen(false)
+      toast.success('Assistant settings saved')
+    } catch { toast.error('Unable to save assistant settings. Check the provider, model and project permissions.') }
+    finally { setApiKey(''); setSaving(false) }
+  }
+
+  const field = 'w-full rounded-md border bg-surface-100 px-3 py-2 text-sm'
+  return <>
+    <Button variant="text" size="tiny" icon={<Settings size={16} />} onClick={() => setOpen(true)}>Assistant settings</Button>
+    <Dialog open={open} onOpenChange={value => { if (!saving) { setOpen(value); setApiKey('') } }}>
+      <DialogContent>
+        <DialogHeader><DialogTitle>Assistant settings for this project</DialogTitle></DialogHeader>
+        <div className="space-y-4 px-6 pb-6">
+          <p className="text-sm text-foreground-light">Your provider key is personal to this project. It is encrypted on the Studio server and is never returned to the browser.</p>
+          {!status ? <p>Loading settings…</p> : <>
+            <label className="block space-y-1"><span>Provider</span>
+              <select className={field} value={provider} disabled={saving} onChange={event => { setProvider(event.target.value as typeof provider); setChangingKey(true); setApiKey('') }}>
+                <option value="openai">OpenAI (Responses API)</option><option value="openrouter">OpenRouter (Chat API)</option>
+              </select></label>
+            <label className="block space-y-1"><span>Model</span><input className={field} value={model} disabled={saving} maxLength={200} autoComplete="off" placeholder="Exact provider model ID" onChange={event => setModel(event.target.value)} /></label>
+            {status.hasKey && !changingKey ? <div className="flex items-center justify-between"><span>Provider key configured</span><Button variant="default" disabled={saving} onClick={() => setChangingKey(true)}>Replace key</Button></div> :
+              <label className="block space-y-1"><span>{status.hasKey ? 'New provider key' : 'Provider key'}</span><input className={field} type="password" value={apiKey} autoComplete="new-password" spellCheck={false} disabled={saving} maxLength={1024} onChange={event => setApiKey(event.target.value)} /></label>}
+            <label className="block space-y-1"><span>Database access</span><select className={field} value={permission} disabled={saving} onChange={event => setPermission(event.target.value as typeof permission)}>
+              <option value="none">No database access</option>
+              {status.maxPermission === 'full' && <><option value="schema">Public schema only</option><option value="read">Read public table rows</option><option value="write">Read and execute approved [AI] functions</option><option value="full">Full public-table SQL access</option></>}
+            </select></label>
+            <p className="text-sm text-foreground-light">Schema and row results are sent to your provider. Database tools require project administration. Full access enables supported public-table SQL, including CREATE TABLE, CREATE INDEX, INSERT and UPDATE, without individual approval. Policy creation and enabling RLS are supported. Table privilege changes for anon/authenticated require explicit confirmation. DELETE, existing-policy changes and removal of RLS protection require explicit confirmation. Full SQL uses tenant administration and can bypass row-level security; read-only tools respect RLS. Cluster administration and external URLs are not enabled.</p>
+            <Button block loading={saving} disabled={!model.trim() || ((changingKey || !status.hasKey) && !apiKey) || window.location.protocol !== 'https:'} onClick={save}>Save settings</Button>
+          </>}
+        </div>
+      </DialogContent>
+    </Dialog>
+  </>
+}
diff --git a/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.tsx b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.tsx
new file mode 100644
