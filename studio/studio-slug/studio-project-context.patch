+import { useParams } from 'common'
+import { useRouter } from 'next/router'
+import { useEffect, useRef } from 'react'
+import { toast } from 'sonner'
+
+import { generateSnippetTitle } from './SQLEditor.constants'
+import { createSqlSnippetSkeletonV2 } from './SQLEditor.utils'
+import { useSelectedProjectQuery } from '@/hooks/misc/useSelectedProject'
+import { useProfile } from '@/lib/profile'
+import { useSqlEditorV2StateSnapshot } from '@/state/sql-editor-v2'
+import { createTabId, useTabsStateSnapshot } from '@/state/tabs'
+
+export function useCreateSqlDraft() {
+  const router = useRouter()
+  const { ref, id, content } = useParams()
+  const { data: project } = useSelectedProjectQuery()
+  const { profile } = useProfile()
+  const state = useSqlEditorV2StateSnapshot()
+  const tabs = useTabsStateSnapshot()
+  const pendingDraft = useRef<string | undefined>(undefined)
+
+  useEffect(() => {
+    if (id !== 'new') {
+      pendingDraft.current = undefined
+      return
+    }
+    if (!router.isReady || !ref || !project || !profile || pendingDraft.current) return
+    const snippet = createSqlSnippetSkeletonV2({
+      name: generateSnippetTitle(), sql: content ?? '',
+      owner_id: profile.id, project_id: project.id,
+    })
+    pendingDraft.current = snippet.id
+    state.addSnippet({ projectRef: ref, snippet })
+    tabs.addTab({
+      id: createTabId('sql', { id: snippet.id }), type: 'sql', label: snippet.name,
+      metadata: { sqlId: snippet.id, name: snippet.name }, isPreview: false,
+    })
+    state.addNeedsSaving(snippet.id)
+    void router.replace(`/project/${ref}/sql/${snippet.id}`, undefined, { shallow: true })
+      .catch(() => toast.error('Unable to open the new query; its tab has been preserved'))
+  }, [router.isReady, ref, id, content, project, profile, router, state, tabs])
+}
