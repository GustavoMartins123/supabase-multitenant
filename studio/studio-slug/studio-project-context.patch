+vi.mock('@/state/shortcuts/useIsShortcutEnabled', () => ({ useIsShortcutEnabled: () => false }))
+vi.mock('@/state/sql-editor/sql-editor-save-coordinator', () => ({ useSqlEditorSaveCoordinator: () => ({ requestSave: vi.fn() }) }))
+vi.mock('@/components/ui/CodeEditor/CodeEditor', () => ({ CodeEditor: ({ id, onInputChange }: any) => (
+  <input aria-label={id} onChange={(event) => onInputChange(event.target.value)} />
+) }))
+const props = { snippetName: 'Query', editorRef: { current: null }, monacoRef: { current: null }, executeQuery: vi.fn(), executeExplainQuery: vi.fn(), prettifyQuery: vi.fn(), onHasSelection: vi.fn() }
+
+describe('SQL editor changes', () => {
+  beforeEach(() => vi.clearAllMocks())
+  it('records text before switching tabs, without a second debounce', () => {
+    const { rerender } = render(<MonacoEditor id="first" {...props} />)
+    fireEvent.change(screen.getByLabelText('first'), { target: { value: 'select 99' } })
+    rerender(<MonacoEditor id="second" {...props} />)
+    expect(fixture.state.setSql).toHaveBeenCalledWith({ id: 'first', sql: 'select 99', shouldInvalidate: true })
+    expect(fixture.state.setSql).not.toHaveBeenCalledWith(expect.objectContaining({ id: 'second' }))
+  })
+  it('queues saving an editor cleared to an empty string', () => {
+    render(<MonacoEditor id="second" {...props} />)
+    fireEvent.change(screen.getByLabelText('second'), { target: { value: 'something' } })
+    fireEvent.change(screen.getByLabelText('second'), { target: { value: '' } })
+    expect(fixture.state.setSql).toHaveBeenLastCalledWith({ id: 'second', sql: '', shouldInvalidate: false })
+  })
+})
