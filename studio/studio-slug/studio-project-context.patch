diff --git a/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx b/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx
new file mode 100644
--- /dev/null
+++ b/apps/studio/components/ui/AIAssistantPanel/SelfHostedAssistantSettings.tsx
@@ -0,0 +1,95 @@
+import { useQueryClient } from '@tanstack/react-query'
+import { Settings } from 'lucide-react'
+import { useEffect, useState } from 'react'
+import { Button, Dialog, DialogContent, DialogHeader, DialogTitle } from 'ui'
+import { toast } from 'sonner'
+
+import { fetchHandler } from '@/data/fetchers'
+import { useSelectedProjectQuery } from '@/hooks/misc/useSelectedProject'
+import { BASE_PATH } from '@/lib/constants'
+
+type SettingsState = {
+  hasKey: boolean
+  provider?: 'openai' | 'openrouter'
+  model?: string
+  permission?: 'none' | 'schema' | 'read' | 'write' | 'full'
+  maxPermission: 'none' | 'full'
+}
+
+export function SelfHostedAssistantSettings() {
+  const { data: project } = useSelectedProjectQuery()
+  const queryClient = useQueryClient()
+  const [open, setOpen] = useState(false)
+  const [status, setStatus] = useState<SettingsState>()
+  const [provider, setProvider] = useState<'openai' | 'openrouter'>('openai')
+  const [model, setModel] = useState('')
+  const [permission, setPermission] = useState<'none' | 'schema' | 'read' | 'write' | 'full'>('none')
+  const [apiKey, setApiKey] = useState('')
+  const [changingKey, setChangingKey] = useState(false)
+  const [saving, setSaving] = useState(false)
+
+  useEffect(() => {
+    setApiKey('')
+    setStatus(undefined)
+    setChangingKey(false)
+    if (!open || !project?.ref) return
+    const controller = new AbortController()
+    fetchHandler(`${BASE_PATH}/api/ai/settings`, { signal: controller.signal, cache: 'no-store' })
+      .then(async response => {
+        if (!response.ok) throw new Error('Unable to load assistant settings')
+        const data: SettingsState = await response.json()
+        if (controller.signal.aborted) return
+        setStatus(data)
+        setProvider(data.provider ?? 'openai')
+        setModel(data.model ?? '')
+        setPermission(data.permission ?? 'none')
+      })
+      .catch(() => { if (!controller.signal.aborted) toast.error('Unable to load assistant settings') })
+    return () => { controller.abort(); setApiKey('') }
+  }, [open, project?.ref])
+
+  const save = async () => {
+    if (!status || !project?.ref || window.location.protocol !== 'https:') return
+    setSaving(true)
+    try {
+      const response = await fetchHandler(`${BASE_PATH}/api/ai/settings`, {
+        method: 'PUT', headers: { 'Content-Type': 'application/json' }, cache: 'no-store',
+        body: JSON.stringify({ provider, model, permission, ...(apiKey ? { apiKey } : {}) }),
+      })
+      if (!response.ok) throw new Error('Unable to save assistant settings')
+      await queryClient.invalidateQueries({ queryKey: ['api-key'] })
+      setChangingKey(false)
+      setOpen(false)
+      toast.success('Assistant settings saved')
+    } catch { toast.error('Unable to save assistant settings. Check the provider, model and project permissions.') }
+    finally { setApiKey(''); setSaving(false) }
+  }
+
+  const field = 'w-full rounded-md border bg-surface-100 px-3 py-2 text-sm'
+  return <>
+    <Button variant="text" size="tiny" icon={<Settings size={16} />} onClick={() => setOpen(true)}>Assistant settings</Button>
+    <Dialog open={open} onOpenChange={value => { if (!saving) { setOpen(value); setApiKey('') } }}>
+      <DialogContent>
+        <DialogHeader><DialogTitle>Assistant settings for this project</DialogTitle></DialogHeader>
+        <div className="space-y-4 px-6 pb-6">
+          <p className="text-sm text-foreground-light">Your provider key is personal to this project. It is encrypted on the Studio server and is never returned to the browser.</p>
+          {!status ? <p>Loading settings…</p> : <>
+            <label className="block space-y-1"><span>Provider</span>
+              <select className={field} value={provider} disabled={saving} onChange={event => { setProvider(event.target.value as typeof provider); setChangingKey(true); setApiKey('') }}>
+                <option value="openai">OpenAI (Responses API)</option><option value="openrouter">OpenRouter (Chat API)</option>
+              </select></label>
+            <label className="block space-y-1"><span>Model</span><input className={field} value={model} disabled={saving} maxLength={200} autoComplete="off" placeholder="Exact provider model ID" onChange={event => setModel(event.target.value)} /></label>
+            {status.hasKey && !changingKey ? <div className="flex items-center justify-between"><span>Provider key configured</span><Button variant="default" disabled={saving} onClick={() => setChangingKey(true)}>Replace key</Button></div> :
+              <label className="block space-y-1"><span>{status.hasKey ? 'New provider key' : 'Provider key'}</span><input className={field} type="password" value={apiKey} autoComplete="new-password" spellCheck={false} disabled={saving} maxLength={1024} onChange={event => setApiKey(event.target.value)} /></label>}
+            <label className="block space-y-1"><span>Database access</span><select className={field} value={permission} disabled={saving} onChange={event => setPermission(event.target.value as typeof permission)}>
+              <option value="none">No database access</option>
+              {status.maxPermission === 'full' && <><option value="schema">Public schema only</option><option value="read">Read public table rows</option><option value="write">Read and execute approved [AI] functions</option><option value="full">Full public-table SQL access</option></>}
+            </select></label>
+            <p className="text-sm text-foreground-light">Schema and row results are sent to your provider. Database tools require project administration. Full access enables supported public-table SQL, including CREATE TABLE, CREATE INDEX, INSERT and UPDATE, without individual approval. Policy creation and enabling RLS are supported. DELETE, existing-policy changes and removal of RLS protection require explicit confirmation. Full SQL uses tenant administration and can bypass row-level security; read-only tools respect RLS. Cluster administration and external URLs are not enabled.</p>
+            <Button block loading={saving} disabled={!model.trim() || ((changingKey || !status.hasKey) && !apiKey) || window.location.protocol !== 'https:'} onClick={save}>Save settings</Button>
+          </>}
+        </div>
+      </DialogContent>
+    </Dialog>
+  </>
+}
diff --git a/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.tsx b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.tsx
new file mode 100644
--- /dev/null
+++ b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.tsx
@@ -0,0 +1,36 @@
+import type { ToolUIPart } from 'ai'
+import { useState } from 'react'
+import { Button } from 'ui'
+
+import { useMessageActionsContext, useMessageInfoContext } from './Message.Context'
+
+export function SelfHostedExecution({ toolPart }: { toolPart: ToolUIPart }) {
+  const { addToolApprovalResponse } = useMessageActionsContext()
+  const { readOnly, isLoading } = useMessageInfoContext()
+  const [confirmedCall, setConfirmedCall] = useState<string>()
+  const destructive = toolPart.type === 'tool-execute_destructive_sql' || toolPart.type === 'tool-execute_function'
+  const input = toolPart.input as { sql?: string; label?: string } | undefined
+  const confirmed = confirmedCall === toolPart.toolCallId
+  return <div className="my-4 space-y-3 rounded-md border p-3">
+    <p className="font-medium">{input?.label ?? 'Database operation'}</p>
+    {destructive && <p className="text-sm text-danger">This operation may permanently delete data, change existing access policies, remove RLS protection or have indirect side effects. Full access does not authorize deletion automatically.</p>}
+    <pre className="max-h-80 overflow-auto whitespace-pre-wrap text-xs">{input?.sql ?? JSON.stringify(toolPart.input, null, 2)}</pre>
+    {toolPart.state === 'approval-requested' && <>
+      <p className="text-sm">Review the exact operation before authorizing it. Approval applies only to this call.</p>
+      {destructive && <label className="flex items-start gap-2 text-sm">
+        <input type="checkbox" checked={confirmed} disabled={readOnly || isLoading} onChange={event => setConfirmedCall(event.target.checked ? toolPart.toolCallId : undefined)} />
+        <span>I explicitly authorize deletion, security changes and the side effects of this exact operation.</span>
+      </label>}
+      <div className="flex gap-2">
+        <Button disabled={readOnly || isLoading || !addToolApprovalResponse || (destructive && !confirmed)} onClick={() => addToolApprovalResponse?.({ id: toolPart.approval.id, approved: true })}>
+          {destructive ? 'Authorize destructive or security changes' : 'Approve execution'}
+        </Button>
+        <Button variant="default" disabled={readOnly || isLoading || !addToolApprovalResponse} onClick={() => addToolApprovalResponse?.({ id: toolPart.approval.id, approved: false })}>Deny</Button>
+      </div>
+    </>}
+    {toolPart.state === 'approval-responded' && <p className="text-sm">{toolPart.approval.approved ? 'Approved; waiting for execution.' : 'Denied; nothing was executed.'}</p>}
+    {toolPart.state === 'output-denied' && <p className="text-sm">Denied; nothing was executed.</p>}
+    {toolPart.state === 'output-error' && <p className="text-sm text-danger">{toolPart.errorText}</p>}
+    {toolPart.state === 'output-available' && <pre className="max-h-80 overflow-auto whitespace-pre-wrap text-xs">{JSON.stringify(toolPart.output, null, 2)}</pre>}
+  </div>
+}
diff --git a/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.test.tsx b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.test.tsx
new file mode 100644
--- /dev/null
+++ b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.test.tsx
@@ -0,0 +1,61 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import type { ToolUIPart } from 'ai'
+import { describe, expect, it, vi } from 'vitest'
+
+import { MessageProvider, type AddToolApprovalResponse } from './Message.Context'
+import { SelfHostedExecution } from './SelfHostedExecution'
+
+const part = (type: ToolUIPart['type'] = 'tool-execute_destructive_sql'): Extract<ToolUIPart, { state: 'approval-requested' }> => ({
+  type, state: 'approval-requested', toolCallId: 'call-one',
+  input: { sql: 'DELETE FROM public.items WHERE id=1', label: 'Delete item' }, approval: { id: 'approval-one' },
+})
+const view = (toolPart: ToolUIPart, respond: AddToolApprovalResponse, readOnly = false, isLoading = false) => (
+  <MessageProvider messageInfo={{ id: 'message', state: 'idle', readOnly, isLoading }}
+    messageActions={{ addToolApprovalResponse: respond, onDelete: vi.fn(), onEdit: vi.fn(), onCancelEdit: vi.fn() }}>
+    <SelfHostedExecution toolPart={toolPart} />
+  </MessageProvider>
+)
+
+describe('Self-hosted database execution', () => {
+  it('requires dedicated explicit deletion confirmation before approving', () => {
+    const respond = vi.fn()
+    render(view(part(), respond))
+    const approve = screen.getByRole('button', { name: 'Authorize destructive or security changes' })
+    expect(approve).toBeDisabled()
+    fireEvent.click(approve)
+    expect(respond).not.toHaveBeenCalled()
+    expect(screen.getByText('DELETE FROM public.items WHERE id=1')).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('checkbox'))
+    fireEvent.click(approve)
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: true })
+  })
+
+  it('allows denial without deletion confirmation and never reuses confirmation for another call', () => {
+    const respond = vi.fn()
+    const { rerender } = render(view(part(), respond))
+    fireEvent.click(screen.getByRole('button', { name: 'Deny' }))
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: false })
+    fireEvent.click(screen.getByRole('checkbox'))
+    rerender(view({ ...part(), toolCallId: 'call-two', approval: { id: 'approval-two' } }, respond))
+    expect(screen.getByRole('checkbox')).not.toBeChecked()
+    expect(screen.getByRole('button', { name: 'Authorize destructive or security changes' })).toBeDisabled()
+  })
+
+  it('shows ordinary SQL approval without granting destructive approval', () => {
+    const respond = vi.fn()
+    render(view({ ...part('tool-execute_sql'), input: { sql: 'UPDATE public.items SET id=2', label: 'Update item' } }, respond))
+    expect(screen.queryByRole('checkbox')).not.toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Approve execution' }))
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: true })
+  })
+
+  it('cannot approve from read-only history or while a response is still streaming', () => {
+    const respond = vi.fn()
+    const { rerender } = render(view(part(), respond, true))
+    expect(screen.getByRole('checkbox')).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'Authorize destructive or security changes' })).toBeDisabled()
+    rerender(view(part(), respond, false, true))
+    expect(screen.getByRole('checkbox')).toBeDisabled()
+    expect(respond).not.toHaveBeenCalled()
+  })
+})
