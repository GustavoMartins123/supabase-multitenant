+++ b/apps/studio/data/content/content-identity.test.ts
@@ -0,0 +1,39 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { upsertContent } from './content-upsert-mutation'
+import { getSqlSnippetById } from './content-id-query'
+
+const fixture = vi.hoisted(() => ({ put: vi.fn(), get: vi.fn() }))
+vi.mock('@/data/fetchers', () => ({ ...fixture, handleError: (error: Error) => { throw error } }))
+const id = '11111111-1111-4111-8111-111111111111'
+const snippet = { id, type: 'sql', content: { content_id: id, schema_version: '1.0', sql: 'select 1' } }
+const payload = { ...snippet, content: { content_id: id, schema_version: '1.0', unchecked_sql: 'select 1' } } as any
+
+describe('content identity contract', () => {
+  beforeEach(() => vi.clearAllMocks())
+  it('maps saved SQL without replacing the client identity', async () => {
+    fixture.put.mockResolvedValue({ data: snippet })
+    const result = await upsertContent({ projectRef: 'ref', payload })
+    expect(result?.id).toBe(id)
+    expect(result?.content?.unchecked_sql).toBe('select 1')
+    expect(result?.content).not.toHaveProperty('sql')
+    expect(result?.status).toBe('saved')
+  })
+  it('rejects a save whose backend ID differs', async () => {
+    fixture.put.mockResolvedValue({ data: { ...snippet, id: 'other' } })
+    await expect(upsertContent({ projectRef: 'ref', payload })).rejects.toThrow('identity')
+  })
+  it('rejects mismatched content IDs', async () => {
+    fixture.put.mockResolvedValue({ data: { ...snippet, content: { ...snippet.content, content_id: 'other' } } })
+    await expect(upsertContent({ projectRef: 'ref', payload })).rejects.toThrow('identity')
+  })
+  it('rejects a missing save response explicitly', async () => {
+    fixture.put.mockResolvedValue({ data: null })
+    await expect(upsertContent({ projectRef: 'ref', payload })).rejects.toThrow()
+  })
+  it('loads exactly the requested identity', async () => {
+    fixture.get.mockResolvedValue({ data: snippet })
+    expect((await getSqlSnippetById({ projectRef: 'ref', id })).id).toBe(id)
+    fixture.get.mockResolvedValue({ data: { ...snippet, id: 'other' } })
+    await expect(getSqlSnippetById({ projectRef: 'ref', id })).rejects.toThrow('identity')
+  })
+})
