+++ b/apps/studio/components/ui/AIAssistantPanel/SelfHostedExecution.test.tsx
@@ -0,0 +1,77 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import type { ToolUIPart } from 'ai'
+import { describe, expect, it, vi } from 'vitest'
+
+import { MessageProvider, type AddToolApprovalResponse } from './Message.Context'
+import { SelfHostedExecution } from './SelfHostedExecution'
+
+const part = (type: ToolUIPart['type'] = 'tool-execute_destructive_sql'): Extract<ToolUIPart, { state: 'approval-requested' }> => ({
+  type, state: 'approval-requested', toolCallId: 'call-one',
+  input: { sql: 'DELETE FROM public.items WHERE id=1', label: 'Delete item' }, approval: { id: 'approval-one' },
+})
+const view = (toolPart: ToolUIPart, respond: AddToolApprovalResponse, readOnly = false, isLoading = false) => (
+  <MessageProvider messageInfo={{ id: 'message', state: 'idle', readOnly, isLoading }}
+    messageActions={{ addToolApprovalResponse: respond, onDelete: vi.fn(), onEdit: vi.fn(), onCancelEdit: vi.fn() }}>
+    <SelfHostedExecution toolPart={toolPart} />
+  </MessageProvider>
+)
+
+describe('Self-hosted database execution', () => {
+  for (const operation of ['grant', 'revoke']) {
+    it(`${operation} table privileges requires explicit confirmation of the exact targets`, () => {
+      const respond = vi.fn()
+      const toolPart = { ...part('tool-manage_table_privileges'), input: { operation, tables: ['clientes', 'pedidos'], role: 'authenticated', privileges: ['SELECT'], label: 'Table privileges' } }
+      render(view(toolPart, respond))
+      expect(screen.getByText(/RLS and policies remain unchanged/)).toBeInTheDocument()
+      expect(screen.getByText(/"authenticated"/)).toBeInTheDocument()
+      const approve = screen.getByRole('button', { name: 'Authorize privilege change' })
+      expect(approve).toBeDisabled()
+      fireEvent.click(approve)
+      expect(respond).not.toHaveBeenCalled()
+      fireEvent.click(screen.getByRole('checkbox'))
+      fireEvent.click(approve)
+      expect(respond).toHaveBeenCalledWith({ id: 'approval-one', approved: true })
+    })
+  }
+  it('requires dedicated explicit deletion confirmation before approving', () => {
+    const respond = vi.fn()
+    render(view(part(), respond))
+    const approve = screen.getByRole('button', { name: 'Authorize destructive or security changes' })
+    expect(approve).toBeDisabled()
+    fireEvent.click(approve)
+    expect(respond).not.toHaveBeenCalled()
+    expect(screen.getByText('DELETE FROM public.items WHERE id=1')).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('checkbox'))
+    fireEvent.click(approve)
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: true })
+  })
+
+  it('allows denial without deletion confirmation and never reuses confirmation for another call', () => {
+    const respond = vi.fn()
+    const { rerender } = render(view(part(), respond))
+    fireEvent.click(screen.getByRole('button', { name: 'Deny' }))
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: false })
+    fireEvent.click(screen.getByRole('checkbox'))
+    rerender(view({ ...part(), toolCallId: 'call-two', approval: { id: 'approval-two' } }, respond))
+    expect(screen.getByRole('checkbox')).not.toBeChecked()
+    expect(screen.getByRole('button', { name: 'Authorize destructive or security changes' })).toBeDisabled()
+  })
+
+  it('shows ordinary SQL approval without granting destructive approval', () => {
+    const respond = vi.fn()
+    render(view({ ...part('tool-execute_sql'), input: { sql: 'UPDATE public.items SET id=2', label: 'Update item' } }, respond))
+    expect(screen.queryByRole('checkbox')).not.toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Approve execution' }))
+    expect(respond).toHaveBeenCalledExactlyOnceWith({ id: 'approval-one', approved: true })
+  })
+
+  it('cannot approve from read-only history or while a response is still streaming', () => {
+    const respond = vi.fn()
+    const { rerender } = render(view(part(), respond, true))
+    expect(screen.getByRole('checkbox')).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'Authorize destructive or security changes' })).toBeDisabled()
+    rerender(view(part(), respond, false, true))
+    expect(screen.getByRole('checkbox')).toBeDisabled()
+    expect(respond).not.toHaveBeenCalled()
+  })
+})
