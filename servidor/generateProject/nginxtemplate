worker_processes 1;
worker_rlimit_nofile 16384;
pid /tmp/nginx.pid;
events {
    worker_connections 4096;
    use epoll;
    multi_accept on;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;
    resolver 127.0.0.11 valid=30s ipv6=off;
    map_hash_bucket_size 256;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 1000;
    proxy_connect_timeout  60s;
    proxy_read_timeout     600s;
    proxy_send_timeout     600s;
    send_timeout           600s;

    client_body_timeout    120s;
    client_header_timeout  60s;
    client_max_body_size   50m;
    large_client_header_buffers 4 32k;
    client_header_buffer_size 16k;
    proxy_buffer_size 256k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    
    server_names_hash_bucket_size 128;

    gzip on;
    gzip_types application/json application/javascript text/plain text/css application/xml;
    gzip_min_length 1024;

    include /etc/nginx/mime.types;
    map "" $auth_upstream     { default "supabase-auth-{{project_id}}:9999"; }
    map "" $rest_upstream     { default "supabase-rest-{{project_id}}:3000"; }
    map "" $storage_upstream  { default "supabase-storage-global:5000"; }
    map "" $functions_upstream{ default "functions:9000"; }
    map "" $realtime_upstream { default "realtime-dev.supabase-realtime:4000"; }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $opaque_role $opaque_internal_jwt {
        default "";
        anon "${ANON_KEY_PROJETO}";
        service_role "${SERVICE_ROLE_KEY_PROJETO}";
    }

    map $opaque_key_present $opaque_upstream_apikey {
        default "";
        "1" $opaque_internal_jwt;
    }

    map $opaque_preserve_authorization $opaque_upstream_authorization {
        default "";
        "0" "Bearer $opaque_internal_jwt";
        "1" $http_authorization;
    }

    map $args $opaque_realtime_args_without_apikey {
        default $args;
        ~^apikey=[^&]*$ "";
        ~^apikey=[^&]*&(?<opaque_rt_after>.*)$ $opaque_rt_after;
        ~^(?<opaque_rt_before>.*)&apikey=[^&]*$ $opaque_rt_before;
        ~^(?<opaque_rt_before_mid>.*)&apikey=[^&]*&(?<opaque_rt_after_mid>.*)$ $opaque_rt_before_mid&$opaque_rt_after_mid;
    }

    map $opaque_realtime_args_without_apikey $opaque_realtime_upstream_args {
        "" "apikey=$opaque_internal_jwt";
        default "apikey=$opaque_internal_jwt&$opaque_realtime_args_without_apikey";
    }

    map $http_x_config_token $is_valid_config_token {
        default 0;
        "${CONFIG_TOKEN_PROJETO}" 1;
    }

    map $http_x_forwarded_proto $real_scheme {
        default $scheme;
        "~.+"   $http_x_forwarded_proto;
    }

    server {
        listen 8080;
        server_name _{{project_id}};
        absolute_redirect off;
        port_in_redirect off;

        auth_request_set $opaque_role $upstream_http_x_opaque_key_role;
        auth_request_set $opaque_key_present $upstream_http_x_opaque_key_present;
        auth_request_set $opaque_key_id $upstream_http_x_opaque_key_id;
        auth_request_set $opaque_preserve_authorization $upstream_http_x_opaque_preserve_authorization;
        auth_request_set $opaque_keyset_version $upstream_http_x_opaque_keyset_version;

        set $cors_origin "";
        if ($http_origin ~* ^(https?://localhost(:\d+)?|https?://{{server_url}}(:\d+)?)$) {
            set $cors_origin $http_origin;
        }

        location = /_internal/opaque-key-authorize {
            internal;
            proxy_pass http://key-authorizer:18010/v1/authorize;
            proxy_pass_request_body off;
            proxy_pass_request_headers off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Project-Ref "{{project_id}}";
            proxy_set_header X-Project-Gateway-Token "${API_GATEWAY_TOKEN_PROJETO}";
            proxy_set_header X-Api-Key-Header $http_apikey;
            proxy_set_header X-Api-Key-Query $arg_apikey;
            proxy_set_header X-Original-Authorization $http_authorization;
            proxy_set_header X-Original-Args $args;
            proxy_set_header X-Target-Service $opaque_target_service;
            proxy_set_header X-Required-Role $opaque_required_role;
            proxy_set_header X-Allow-Missing-Key $opaque_allow_missing_key;
        }
       
        location /recovery.html {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location /invite.html {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location /magiclink.html {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location /confirmation.html {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location /email_change.html {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location = /verify-success.html {
            root /usr/share/nginx/html;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location = /verify-success.html/ {
            root /usr/share/nginx/html;
            try_files /verify-success.html =404;
            add_header Content-Type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location = /verify-success.js {
            root /usr/share/nginx/html;
            default_type application/javascript;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        location = /verify-success.html/verify-success.js {
            root /usr/share/nginx/html;
            try_files /verify-success.js =404;
            default_type application/javascript;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            expires off;
        }

        
        location /auth/v1/ {
            set $opaque_target_service auth;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, X-Client-Info, X-Supabase-Auth, x-supabase-api-version' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }

            rewrite ^/auth/v1/(.*)$ /$1?$args break;
            
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;

            proxy_pass http://$auth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Uri /{{project_id}}$request_uri;
            proxy_set_header X-Original-URI /{{project_id}}$request_uri;
            proxy_set_header X-Original-URL $real_scheme://$host/{{project_id}}$request_uri;
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;
            
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, X-Client-Info, X-Supabase-Auth, x-supabase-api-version' always;
        }
        
        location = /auth/v1/verify {
            rewrite ^/auth/v1/(.*)$ /$1?$args break;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_pass http://$auth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Uri /{{project_id}}$request_uri;
            proxy_set_header X-Original-URI /{{project_id}}$request_uri;
            proxy_set_header X-Original-URL $real_scheme://$host/{{project_id}}$request_uri;
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey';
             if ($request_method = 'OPTIONS') { return 204; }
        }

        location = /auth/v1/callback {
            rewrite ^/auth/v1/(.*)$ /$1?$args break;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_pass http://$auth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Uri /{{project_id}}$request_uri;
            proxy_set_header X-Original-URI /{{project_id}}$request_uri;
            proxy_set_header X-Original-URL $real_scheme://$host/{{project_id}}$request_uri;
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey';
             if ($request_method = 'OPTIONS') { return 204; }
        }

        location = /auth/v1/authorize {
            rewrite ^/auth/v1/(.*)$ /$1?$args break;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_pass http://$auth_upstream/authorize;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Uri /{{project_id}}$request_uri;
            proxy_set_header X-Original-URI /{{project_id}}$request_uri;
            proxy_set_header X-Original-URL $real_scheme://$host/{{project_id}}$request_uri;
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey';
             if ($request_method = 'OPTIONS') { return 204; }
        }

        location = /rest/v1/ {
            set $opaque_target_service rest;
            set $opaque_required_role service_role;
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;
            rewrite ^/rest/v1/(.*)$ /$1 break; 
            proxy_pass http://$rest_upstream;
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;
        }



        location /rest/v1/ {
            set $opaque_target_service rest;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version, Prefer, Range, Content-Profile, X-Client-Info, accept-profile' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            rewrite ^/rest/v1/(.*)$ /$1 break;
            
            proxy_hide_header Access-Control-Allow-Origin;
            
            proxy_pass http://$rest_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;
            
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version, Prefer, Range, Content-Profile, X-Client-Info, accept-profile' always;
            add_header 'Access-Control-Expose-Headers' 'Content-Range, X-Total-Count';
        }

        location /graphql/v1 {
            set $opaque_target_service graphql;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version, Content-Profile' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_hide_header Access-Control-Allow-Origin;
            
            proxy_pass http://$rest_upstream/rpc/graphql;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Content-Profile graphql_public;
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;
            
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version, Content-Profile' always;
        }

        location ^~ /realtime/v1/websocket {
            access_log off;
            set $opaque_target_service realtime;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;
            
            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version' always;
                return 204;
            }


            rewrite ^/realtime/v1/websocket$ /socket/websocket?$opaque_realtime_upstream_args break;

            proxy_pass http://$realtime_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host "{{project_uuid}}.localhost"; 
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header x-api-key $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;
            proxy_read_timeout 86400;

            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version' always;
        }


        location /storage/v1/ {
            set $opaque_target_service storage;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 1;
            auth_request /_internal/opaque-key-authorize;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PATCH, HEAD, DELETE, PUT' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, Tus-Resumable, Tus-Version, Tus-Max-Size, Tus-Extension, Upload-Length, Upload-Metadata, Upload-Offset, Upload-Concat, Upload-Defer-Length, x-upsert, X-Requested-With, x-supabase-api-version' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }

            client_max_body_size ${FILE_SIZE_LIMIT};

            rewrite ^/storage/v1/(.*)$ /$1 break;
            
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
            proxy_set_header X-Forwarded-Host "{{project_uuid}}.storage.internal";
            proxy_set_header X-Forwarded-Prefix "/{{project_id}}/storage/v1";

            proxy_set_header Tus-Resumable $http_tus_resumable;
            proxy_set_header Tus-Version $http_tus_version;
            proxy_set_header Upload-Length $http_upload_length;
            proxy_set_header Upload-Metadata $http_upload_metadata;
            proxy_set_header Upload-Offset $http_upload_offset;
            proxy_set_header Upload-Concat $http_upload_concat;
            proxy_set_header Upload-Defer-Length $http_upload_defer_length;
            proxy_set_header x-upsert $http_x_upsert;
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;

            proxy_pass http://$storage_upstream;

            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PATCH, HEAD, DELETE, PUT' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, Tus-Resumable, Tus-Version, Tus-Max-Size, Tus-Extension, Upload-Length, Upload-Metadata, Upload-Offset, Upload-Concat, Upload-Defer-Length, x-upsert, X-Requested-With, x-supabase-api-version' always;
        }

        # Endpoint interno dos S3 Vectors Wrappers. O cliente externo nao pode
        # acessar esta rota nem escolher o tenant por header.
        location /vector/ {
            allow ${SUPABASE_NETWORK_SUBNET};
            deny all;

            proxy_pass http://$storage_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host "{{project_uuid}}.storage.internal";
            proxy_set_header X-Forwarded-Prefix "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto http;
        }
        
        location /functions/v1/ {
            set $opaque_target_service functions;
            set $opaque_required_role "";
            set $opaque_allow_missing_key 0;
            auth_request /_internal/opaque-key-authorize;

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }

            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;

            rewrite ^/functions/v1/(.*)$ /$1 break;
            proxy_pass http://$functions_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Project-Ref {{project_id}};
            proxy_set_header apikey $opaque_upstream_apikey;
            proxy_set_header Authorization $opaque_upstream_authorization;
            proxy_set_header X-Api-Key-Id $opaque_key_id;

            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, apikey, x-supabase-api-version' always;
        }

        location = /config {
            if ($is_valid_config_token = 0) {
                return 401;
            }
            
            set $config_url "{{project_public_url}}";
            
            default_type application/json;
            add_header Cache-Control "no-store";
            return 200 '{"supabase_url":"$config_url"}';
        }
    }
}
